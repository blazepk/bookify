def write_map_page(pages: list[Page], out: Path, title: str) -> None:
    import json as jsonlib

    nodes = [{"id": "", "label": title, "kind": "root"}]
    folders = sorted({"/".join(p.rel.parts[:i])
                      for p in pages for i in range(1, len(p.rel.parts))})
    nodes += [{"id": "dir:" + f, "label": humanize(f.rsplit("/", 1)[-1], is_dir=True),
               "kind": "dir"} for f in folders]
    page_ids = set()
    for p in pages:
        pid = str(p.out_rel_html).replace("\\", "/")
        page_ids.add(pid)
        nodes.append({"id": pid, "label": p.title, "kind": "page", "href": pid})

    edges = []
    for f in folders:
        parent = "dir:" + f.rsplit("/", 1)[0] if "/" in f else ""
        edges.append({"s": parent, "t": "dir:" + f, "kind": "tree"})
    for p in pages:
        pid = str(p.out_rel_html).replace("\\", "/")
