// The server's annotations.json stays as a mirror, because IndexedDB is scoped
// to an origin *including the port* -- a book served on another port, or opened
// off disk, is a different database. Merging the two on load means either side
// can rebuild the other. ----
const IDB={db:null,ok:false};
const STORES={books:{keyPath:'id'},
annotations:{keyPath:'id',indexes:{by_book:'bookId',by_page:['bookId','page']}},
chats:{keyPath:'id',indexes:{by_book:'bookId',by_anchor:['bookId','anchor']}}};
function idbOpen(){return new Promise(res=>{
let req;try{req=indexedDB.open('bookify',1)}catch(e){return res(null)}
req.onupgradeneeded=e=>{const d=e.target.result;
for(const[name,spec]of Object.entries(STORES)){
const st=d.objectStoreNames.contains(name)?req.transaction.objectStore(name)
:d.createObjectStore(name,{keyPath:spec.keyPath});
for(const[ix,keys]of Object.entries(spec.indexes||{}))
if(!st.indexNames.contains(ix))st.createIndex(ix,keys)}};
req.onsuccess=()=>res(req.result);
req.onerror=()=>res(null);req.onblocked=()=>res(null)})}
