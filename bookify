def build_tree(pages: list[Page]) -> dict:
    """Nest pages by their section labels. Children keep reading order, with pages
    and sections interleaved, so a nav config that puts a page after a section
    is shown that way."""
    tree: dict = {"children": [], "dirs": {}}
    for p in pages:
        node = tree
        for label in p.section:
            sub = node["dirs"].get(label)
            if sub is None:
                sub = node["dirs"][label] = {"label": label, "children": [], "dirs": {}}
                node["children"].append(sub)
            node = sub
        node["children"].append(p)
    return tree


def nav_html(tree: dict, current: Page, depth_to_root: str) -> str:
    out = ["<ul>"]
    for child in tree["children"]:
        if isinstance(child, Page):
            active = ' class="active"' if child is current else ""
            href = depth_to_root + str(child.out_rel_html).replace("\\", "/")
            out.append(
                f'<li data-t="{html_mod.escape(child.title.lower())}">'
                f'<a href="{href}"{active}>{html_mod.escape(child.title)}</a></li>')
        else:
            is_open = " open" if _contains(child, current) else ""
            out.append(f"<details{is_open}><summary>{html_mod.escape(child['label'])}</summary>")
            out.append(nav_html(child, current, depth_to_root))
            out.append("</details>")
    out.append("</ul>")
    return "".join(out)


def _contains(tree: dict, page: Page) -> bool:
    return any(c is page if isinstance(c, Page) else _contains(c, page)
               for c in tree["children"])


