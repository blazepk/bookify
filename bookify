# "Ask AI": answer questions about a highlighted passage, using whatever the
# machine already has. Ollama is preferred (local, free, streams token by
# token); otherwise we shell out to an installed assistant CLI.

ASK_TIMEOUT = 240

# id -> (label, argv builder, streams?).  argv builders take the flattened
# prompt and a path for the provider to write its final message to.
CLI_PROVIDERS = {
    "claude": {
        "label": "Claude Code",
        "argv": lambda prompt, out: ["claude", "-p", prompt],
        "stream": True,
    },
    "codex": {
        "label": "Codex",
        # writes just the final message to `out`; stdout is progress chrome
        "argv": lambda prompt, out: ["codex", "exec", "--skip-git-repo-check",
                                     "--color", "never", "-o", out, prompt],
        "stream": False,
    },
    "gemini": {
        "label": "Gemini",
        "argv": lambda prompt, out: ["gemini", "-o", "text", "-p", prompt],
        "stream": True,
    },
}
CLI_ORDER = ["claude", "codex", "gemini"]


def detect_providers(ask_model: str) -> list[dict]:
    """Everything on this machine that can answer a question, best first."""
    found = []
    names = ollama_models()
    if names:
        model = pick_model(ask_model, names)
        found.append({"id": "ollama", "label": "Ollama",
                      "detail": model, "streams": True})
    elif names is not None:
        found.append({"id": "ollama", "label": "Ollama", "streams": True,
                      "detail": "no model pulled", "unavailable":
                      f"Ollama is running but has no model. Run: ollama pull {AI_DEFAULT_MODEL}"})
    for pid in CLI_ORDER:
        if shutil.which(pid):
            found.append({"id": pid, "label": CLI_PROVIDERS[pid]["label"],
                          "detail": "CLI", "streams": CLI_PROVIDERS[pid]["stream"]})
    found.sort(key=lambda p: bool(p.get("unavailable")))
    return found


def build_ask_prompt(payload: dict) -> str:
    """Flatten the passage, its context and the conversation into one prompt.

    The assistant CLIs are stateless per invocation, so every turn resends the
    transcript — that is what makes follow-up questions and disagreement work.
    """
    quote = str(payload.get("quote") or "")[:4000]
    context = str(payload.get("context") or "")[:4000]
    book = str(payload.get("book") or "")[:200]
    page = str(payload.get("title") or "")[:200]
    msgs = payload.get("messages") or []

    head = ["You are helping a reader understand a passage from documentation.",
            "Answer from the passage and its surrounding context where you can.",
            "Say plainly when something is not covered by the text rather than "
            "inventing it. Be concise and concrete; plain prose, minimal markdown.",
            "The reader may push back or disagree — engage with the argument."]
    if book:
        head.append(f"Book: {book}")
    if page:
        head.append(f"Page: {page}")
    head += ["", "HIGHLIGHTED PASSAGE:", quote]
    if context and context != quote:
        head += ["", "SURROUNDING CONTEXT:", context]
    head += ["", "CONVERSATION:"]
    for m in msgs[-20:]:
        role = "Reader" if m.get("role") == "user" else "Assistant"
        head.append(f"{role}: {str(m.get('content') or '')[:6000]}")
    head.append("Assistant:")
    return "\n".join(head)


def stream_ollama(payload: dict, model: str, emit) -> None:
    import json as jsonlib
    import urllib.request

    msgs = [{"role": "system", "content": build_ask_prompt({**payload, "messages": []})}]
    for m in payload.get("messages") or []:
        role = "user" if m.get("role") == "user" else "assistant"
        msgs.append({"role": role, "content": str(m.get("content") or "")[:6000]})
    req = urllib.request.Request(
        OLLAMA_BASE + "/api/chat",
        data=jsonlib.dumps({"model": model, "messages": msgs, "stream": True}).encode(),
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=ASK_TIMEOUT) as r:
        for line in r:
            line = line.strip()
            if not line:
                continue
            try:
                obj = jsonlib.loads(line)
            except ValueError:
                continue
            if obj.get("error"):
                emit({"error": str(obj["error"])})
                return
            chunk = (obj.get("message") or {}).get("content") or ""
            if chunk:
                emit({"t": chunk})
            if obj.get("done"):
                return


def stream_cli(payload: dict, pid: str, emit, stop) -> None:
    import subprocess
    import tempfile

    spec = CLI_PROVIDERS[pid]
    prompt = build_ask_prompt(payload)
    with tempfile.TemporaryDirectory(prefix="bookify-ask-") as tmp:
        last = str(Path(tmp) / "last.txt")
        argv = spec["argv"](prompt, last)
        try:
            proc = subprocess.Popen(
                argv, cwd=tmp, stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                start_new_session=True)   # own process group, so stop kills children
        except OSError as exc:
            emit({"error": f"could not start {pid}: {exc}"})
            return
        stop["kill"] = lambda: _kill_group(proc)
        out_chunks: list[bytes] = []
        try:
            fd = proc.stdout.fileno()
            while True:
                data = os.read(fd, 4096)
                if not data:
                    break
                out_chunks.append(data)
                if spec["stream"]:
                    emit({"t": data.decode("utf-8", "replace")})
            proc.wait(timeout=ASK_TIMEOUT)
        except subprocess.TimeoutExpired:
            _kill_group(proc)
            emit({"error": f"{pid} timed out after {ASK_TIMEOUT}s"})
            return
        finally:
            stop["kill"] = None
        err = b""
        try:
            err = proc.stderr.read() or b""
        except OSError:
            pass
        final = ""
        try:
            final = Path(last).read_text(encoding="utf-8", errors="replace").strip()
        except OSError:
            pass
        if not spec["stream"]:
            body = final or b"".join(out_chunks).decode("utf-8", "replace").strip()
            if body:
                emit({"t": body})
                return
        elif b"".join(out_chunks).strip():
            return
        msg = (err.decode("utf-8", "replace").strip()
               or f"{pid} produced no output (exit {proc.returncode})")
        emit({"error": msg[:2000]})


def _kill_group(proc) -> None:
    import signal
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
    except (OSError, ProcessLookupError):
        try:
            proc.kill()
        except OSError:
            pass


