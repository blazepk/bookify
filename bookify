# Rendering

def build_link_maps(pages: list[Page]) -> tuple[dict[str, str], dict[str, str]]:
    """source path (posix, root-relative) -> output path, for each book."""
    html_map = {p.rel.as_posix(): p.out_rel_html.as_posix() for p in pages}
    md_map = {p.rel.as_posix(): p.out_rel_md.as_posix() for p in pages}
    return html_map, md_map


SKIP_HREF = ("http://", "https://", "mailto:", "tel:", "#", "/", "data:", "javascript:")


def _retarget(href: str, page_dir: str, out_dir: str, link_map: dict[str, str],
              fallback) -> str | None:
    """Map one relative href onto the target page's real output path.

    Returns the rewritten href, or None to leave the original untouched.
    Resolving through link_map (rather than swapping the suffix blindly) is what
    keeps links correct when a target had to be renamed to avoid a collision.
    """
    base, _, frag = href.partition("#")
    if not base:
        return None
    # Try the map for any relative href, whatever its extension: with
    # --include-code a link to scripts/foo.py has a rendered page too, and only
    # real pages are ever in the map. Extension-based guessing is the fallback.
    key = posixpath.normpath(posixpath.join(page_dir, base))
    out = link_map.get(key)
    if out is None and not Path(base).suffix:
        # Docusaurus, VitePress and Hugo link to pages without an extension
        stem = "" if key == "." else key
        for cand in (stem + ".md", stem + ".mdx", posixpath.join(stem, "index.md"),
                     posixpath.join(stem, "README.md"), posixpath.join(stem, "index.mdx"),
                     posixpath.join(stem, "_index.md")):
            if cand in link_map:
                out = link_map[cand]
                break
    if out is None:
        ext = Path(base).suffix.lower()
        if ext not in DOC_EXTS and ext not in HTML_EXTS:
            return None
        out = fallback(key)
        if out is None:
            return None
    rel = posixpath.relpath(out, out_dir or ".")
    return rel + ("#" + frag if frag else "")


def rewrite_md_links(html: str, page: Page, link_map: dict[str, str]) -> str:
    """Point relative links at the rendered HTML page for that source file."""
    page_dir = page.rel.parent.as_posix()
    page_dir = "" if page_dir == "." else page_dir
    out_dir = posixpath.dirname(page.out_rel_html.as_posix())

    def fallback(key: str) -> str | None:
        # target isn't a collected page (percent-encoded name, or outside the
        # tree): keep the old behaviour so nothing that used to work breaks
        ext = Path(key).suffix.lower()
        if ext in DOC_EXTS:
            return posixpath.splitext(key)[0] + ".html"
        return None

    def repl(m: re.Match) -> str:
        href = m.group(2)
        if href.startswith(SKIP_HREF):
            return m.group(0)
        new = _retarget(href, page_dir, out_dir, link_map, fallback)
        return m.group(0) if new is None else f"{m.group(1)}{new}{m.group(3)}"

    return re.sub(r'(href=")([^"]+)(")', repl, html)


def collect_assets(pages: list[Page], root: Path) -> dict[str, Path]:
    """Local files the rendered pages point at (images, diagrams, PDFs, fonts).

    Returns {root-relative posix path: source file}. Without copying these, a
    doc that embeds a diagram renders a broken image, since only doc/code files
    are ever collected as pages.
    """
    found: dict[str, Path] = {}
    ref = re.compile(r'(?:src|href)="([^"]+)"')
    root_resolved = root.resolve()
    for page in pages:
        page_dir = page.rel.parent.as_posix()
        page_dir = "" if page_dir == "." else page_dir
        for m in ref.finditer(page.html_body):
            href = m.group(1)
            if href.startswith(SKIP_HREF):
                continue
            base = href.partition("#")[0].partition("?")[0]
            if not base or Path(base).suffix.lower() not in ASSET_EXTS:
                continue
            key = posixpath.normpath(posixpath.join(page_dir, unquote(base)))
            if key.startswith("..") or key in found:
                continue
            src = root / key
            try:
                if not src.is_file() or src.stat().st_size > MAX_ASSET_BYTES:
                    continue
                # don't follow a link out of the tree we were asked to render
                if root_resolved not in src.resolve().parents:
                    continue
            except OSError:
                continue
            found[key] = src
    return found


def copy_assets(assets: dict[str, Path], *dests: Path) -> int:
    n = 0
    for key, src in assets.items():
        for dest_root in dests:
            dest = dest_root / key
            dest.parent.mkdir(parents=True, exist_ok=True)
            try:
                shutil.copyfile(src, dest)
            except OSError:
                continue
        n += 1
    return n


def extract_html_body(text: str) -> str:
    """Pull the displayable content out of a full HTML document."""
    m = re.search(r"<body[^>]*>(.*)</body>", text, re.I | re.S)
    body = m.group(1) if m else re.sub(
        r"<!doctype[^>]*>|</?html[^>]*>|<head[^>]*>.*?</head>", "", text,
        flags=re.I | re.S)
    # scripts and document-level styles would fight the book's own layout
    body = re.sub(r"<script[^>]*>.*?</script>", "", body, flags=re.I | re.S)
    body = re.sub(r"<style[^>]*>.*?</style>", "", body, flags=re.I | re.S)
    return body.strip()


def rewrite_links_for_md_book(text: str, page: Page, md_map: dict[str, str]) -> str:
    """In the Markdown book, pages can be renamed (<name>.<ext>.md, or -2 to
    break a collision) — point relative links at the real output name."""
    page_dir = page.rel.parent.as_posix()
    page_dir = "" if page_dir == "." else page_dir
    out_dir = posixpath.dirname(page.out_rel_md.as_posix())

    def fallback(key: str) -> str | None:
        ext = Path(key).suffix.lower()
        return key if ext in MD_EXTS else key + ".md"

    def fix(href: str) -> str:
        if href.startswith(SKIP_HREF):
            return href
        new = _retarget(href, page_dir, out_dir, md_map, fallback)
        return href if new is None else new

    text = re.sub(r"(\]\()([^)\s]+)(\))", lambda m: m.group(1) + fix(m.group(2)) + m.group(3), text)
    return re.sub(r'(href=")([^"]+)(")', lambda m: m.group(1) + fix(m.group(2)) + m.group(3), text)


WIKILINK = re.compile(r"(!?)\[\[([^\[\]\n]+?)\]\]")
IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".avif", ".bmp"}


def _md_text(s: str) -> str:
    return s.replace("[", r"\[").replace("]", r"\]")


class WikiLinks:
    """Obsidian-style [[wikilinks]] and ![[embeds]], rewritten as ordinary Markdown.

    A name resolves the way Obsidian does: a path if it has one, otherwise any page
    or attachment with that file name, preferring the one nearest the linking page.
    """

    def __init__(self, pages: list[Page], root: Path):
        self.root = root
        self.index = PageIndex(pages)
        self.files: dict[str, list[str]] = {}
        for path in root.rglob("*"):
            if path.suffix.lower() not in ASSET_EXTS or not path.is_file():
                continue
            rel = path.relative_to(root)
            if any(part in SKIP_DIRS or part.startswith(".") for part in rel.parts[:-1]):
                continue
            self.files.setdefault(path.name.lower(), []).append(rel.as_posix())

    @staticmethod
    def _nearest(options: list[str], base: str) -> str:
        return min(options, key=lambda o: (len(posixpath.relpath(o, base or ".").split("/")), o))

    def resolve(self, name: str, base: str) -> tuple["Page | None", "str | None"]:
        name = name.strip()
        if not name:
            return None, None
        if Path(name).suffix.lower() in ASSET_EXTS:
            for cand in (posixpath.normpath(posixpath.join(base, name)), posixpath.normpath(name)):
                if (self.root / cand).is_file():
                    return None, cand
            hits = self.files.get(Path(name).name.lower())
            return None, self._nearest(hits, base) if hits else None
        page = self.index.find(name, base)
        if page is None:
            last = name.rsplit("/", 1)[-1]
            key = (Path(last).stem if Path(last).suffix.lower() in DOC_EXTS else last).lower()
            hits = self.index.by_stem.get(key, [])
            if hits:
                page = min(hits, key=lambda p: (len(posixpath.relpath(p.rel.as_posix(),
                                                                      base or ".").split("/")),
                                                p.rel.as_posix()))
        return page, None

    def link(self, raw: str, display: str, base: str) -> str:
        from markdown.extensions.toc import slugify

        name, _, anchor = raw.partition("#")
        heading = anchor.split("#")[-1].strip()
        if heading.startswith("^"):   # block references have no anchor outside Obsidian
            heading = ""
        if not name.strip():          # [[#Heading]] on the same page
            text = display or heading
            return f"[{_md_text(text)}](#{slugify(heading, '-')})" if heading else text
        page, file = self.resolve(name, base)
        dest = page.rel.as_posix() if page else file
        text = display or (f"{name.strip()} > {heading}" if heading else name.strip())
        if not dest:
            return (f'<span class="wikilink missing" title="No page named '
                    f'{html_mod.escape(name.strip())}">{html_mod.escape(text)}</span>')
        href = posixpath.relpath(dest, base or ".")
        if heading and page:
            href += "#" + slugify(heading, "-")
        return f"[{_md_text(text)}](<{href}>)"

    def embed(self, raw: str, base: str) -> str:
        target, _, size = raw.partition("|")
        name = target.partition("#")[0]
        page, file = self.resolve(name, base)
        if file is None:
            return self.link(target, "", base)
        href = posixpath.relpath(file, base or ".")
        if Path(file).suffix.lower() not in IMAGE_EXTS:
            return f"[{_md_text(Path(file).name)}](<{href}>)"
        m = re.fullmatch(r"\s*(\d+)(?:x(\d+))?\s*", size)
        attrs = ""
        if m:
            attrs = f'{{ width="{m.group(1)}"' + (f' height="{m.group(2)}"' if m.group(2) else "") + " }"
        return f"![{_md_text(Path(file).stem)}](<{href}>){attrs}"

    def inline(self, line: str, base: str) -> str:
        """Rewrite every wikilink on a line, leaving inline code alone."""
        def one(m: re.Match) -> str:
            # inside a table Obsidian escapes the alias pipe as \|
            raw = m.group(2).replace("\\|", "|")
            if m.group(1):
                return self.embed(raw, base)
            name, _, display = raw.partition("|")
            return self.link(name, display, base)

        # a wikilink that starts inside inline code is an example; inline code inside
        # a wikilink's alias is just formatting
        spans = [m.span() for m in re.finditer(r"`+[^`]*`+", line)]
        return WIKILINK.sub(
            lambda m: m.group(0) if any(a <= m.start() < b for a, b in spans) else one(m), line)

    def transclude(self, raw: str, base: str, current: "Page | None") -> "list[str] | None":
        """The lines of an embedded note, or one of its sections, framed with a link back."""
        from markdown.extensions.toc import slugify

        target = raw.partition("|")[0]
        name, _, anchor = target.partition("#")
        page, _ = self.resolve(name, base)
        if page is None or page is current or page.kind != "md":
            return None
        _, body = split_front_matter(page.src.read_text(encoding="utf-8", errors="replace"))
        lines = body.split("\n")
        heading = anchor.split("#")[-1].strip()
        if heading and not heading.startswith("^"):
            start = level = None
            for n, line in enumerate(lines):
                h = re.match(r"^(#{1,6})\s+(.*?)\s*#*\s*$", line)
                if not h:
                    continue
                if start is None and slugify(h.group(2), "-") == slugify(heading, "-"):
                    start, level = n + 1, len(h.group(1))
                elif start is not None and len(h.group(1)) <= level:
                    lines = lines[start:n]
                    break
            else:
                if start is None:
                    return None
                lines = lines[start:]
        else:
            heading = ""
        href = posixpath.relpath(page.rel.as_posix(), base or ".")
        if heading:
            href += "#" + slugify(heading, "-")
        label = page.title + (f" › {heading}" if heading else "")
        return ["", '<div class="embed" markdown="1">',
                f'<p class="embed-source"><a href="{html_mod.escape(href)}">{html_mod.escape(label)}</a></p>',
                "", *lines, "", "</div>", ""]


