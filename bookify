# Markdown book

def write_md_book(pages: list[Page], out: Path, title: str) -> None:
    out.mkdir(parents=True, exist_ok=True)
    summary = [f"# {title}\n", "## Table of Contents\n"]
    combined = [f"# {title}\n"]
    for page in pages:
        dest = out / page.out_rel_md
        dest.parent.mkdir(parents=True, exist_ok=True)
        body = page.md_body
        if page.kind != "md" or not re.match(r"^#\s", body.lstrip()):
            body = f"# {page.title}\n\n{body}"
        dest.write_text(body, encoding="utf-8")
        indent = "  " * (len(page.rel.parts) - 1)
        link = str(page.out_rel_md).replace("\\", "/")
        summary.append(f"{indent}- [{page.title}]({link})")
        combined.append(f"\n---\n\n<!-- source: {page.rel} -->\n\n{body}\n")
    (out / "SUMMARY.md").write_text("\n".join(summary) + "\n", encoding="utf-8")
    (out / "BOOK.md").write_text("\n".join(combined), encoding="utf-8")


