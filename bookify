JS = """
// ---- theme: auto -> light -> dark, persisted; data-theme wins over OS pref ----
(()=>{const KEY='bookify-theme',root=document.documentElement;
const btn=document.getElementById('themetoggle');
const ICO={auto:'\\u25D0',light:'\\u2600',dark:'\\u263E'};
let mode='auto';try{mode=localStorage.getItem(KEY)||'auto'}catch(e){}
if(!(mode in ICO))mode='auto';
const apply=()=>{if(mode==='auto')root.removeAttribute('data-theme');
else root.setAttribute('data-theme',mode);
if(btn)btn.textContent=ICO[mode]+' '+mode[0].toUpperCase()+mode.slice(1);};
apply();
if(btn)btn.addEventListener('click',()=>{mode={auto:'light',light:'dark',dark:'auto'}[mode];
try{localStorage.setItem(KEY,mode)}catch(e){}apply();});})();

// ---- shared sidebar: a large book ships its tree once, in nav.js; fill it in here,
// before the filter below looks at it ----
(()=>{const tree=document.querySelector('nav.sidebar .tree[data-shared]');
if(!tree||typeof window.BOOKIFY_NAV!=='string')return;
const ROOT=document.body.dataset.root||'',PAGE=document.body.dataset.page||'';
tree.innerHTML=window.BOOKIFY_NAV;
let active=null;
tree.querySelectorAll('a[href]').forEach(a=>{const h=a.getAttribute('href');
if(h===PAGE){active=a;a.classList.add('active');
for(let d=a.closest('details');d;d=d.parentElement.closest('details'))d.open=true}
a.setAttribute('href',ROOT+h)});
if(active){const t=tree.getBoundingClientRect(),r=active.getBoundingClientRect();
tree.scrollTop+=r.top-t.top-tree.clientHeight/2}})();

// ---- sidebar filter ----
(()=>{const q=document.getElementById('navfilter');if(!q)return;
const tree=document.querySelector('nav.sidebar .tree');if(!tree)return;
const groups=[...tree.querySelectorAll('details')];
const wasOpen=new Map(groups.map(d=>[d,d.open]));
let empty=null;
q.addEventListener('input',()=>{const v=q.value.trim().toLowerCase();
let hits=0;
tree.querySelectorAll('li[data-t]').forEach(li=>{
const on=!v||li.dataset.t.includes(v);li.hidden=!on;if(on)hits++});
// a folder whose name matches counts as a hit and reveals its contents
groups.forEach(d=>{const name=(d.querySelector('summary')||{}).textContent||'';
const self=!!v&&name.toLowerCase().includes(v);
if(self){d.querySelectorAll('li[data-t]').forEach(li=>{if(li.hidden){li.hidden=false;hits++}})}
const kept=[...d.querySelectorAll('li[data-t]')].some(li=>!li.hidden);
