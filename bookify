# Optional AI overview via a local Ollama server

AI_DEFAULT_MODEL = "llama3.2:3b"
# override to point at Ollama somewhere else (another port, another machine)
OLLAMA_BASE = os.environ.get("BOOKIFY_OLLAMA", "http://127.0.0.1:11434").rstrip("/")


def ollama_models(timeout: float = 3) -> "list[str] | None":
    """Names of pulled models, or None if Ollama isn't reachable."""
    import json as jsonlib
    import urllib.request
    try:
        with urllib.request.urlopen(OLLAMA_BASE + "/api/tags", timeout=timeout) as r:
            return [m["name"] for m in jsonlib.loads(r.read()).get("models", [])]
    except (OSError, ValueError, KeyError):
        return None


def pick_model(want: str, names: list[str]) -> "str | None":
    """The wanted model if pulled (bare name matches any tag), else the first."""
    for n in names:
        if n == want or n.startswith(want + ":"):
            return n
    return names[0] if names else None


def ai_overview(pages: list[Page], out: Path, title: str, model: str) -> "Page | None":
    import json as jsonlib
    import urllib.error
    import urllib.request

    base = OLLAMA_BASE

    def post(path: str, payload: dict, timeout: int = 300) -> dict:
        req = urllib.request.Request(
            base + path, data=jsonlib.dumps(payload).encode(),
            headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return jsonlib.loads(r.read())

    names = ollama_models()
    if names is None:
        print(f"bookify: --ai skipped — Ollama is not reachable at {base}.\n"
              "  Install: brew install ollama   Start: ollama serve\n"
              f"  Pull a small model: ollama pull {AI_DEFAULT_MODEL}", file=sys.stderr)
        return None
    if not names:
        print(f"bookify: --ai skipped — no models pulled. "
              f"Run: ollama pull {model}", file=sys.stderr)
        return None
    chosen = pick_model(model, names)
    if chosen != model:
        model = chosen
        print(f"bookify: requested model not pulled; using '{model}'. "
              f"(Lighter option: ollama pull {AI_DEFAULT_MODEL})", file=sys.stderr)

    cache_f = out / "ai-cache.json"   # keyed by content hash; survives rebuilds
    try:
        cache = jsonlib.loads(cache_f.read_text()) if cache_f.exists() else {}
    except ValueError:
        cache = {}

    todo = pages[:60]
    if len(pages) > 60:
        print(f"bookify: --ai summarizing the first 60 of {len(pages)} pages")
    summaries = []
    for i, p in enumerate(todo, 1):
        key = hashlib.sha1((model + "\x00" + p.md_body).encode()).hexdigest()
        if key not in cache:
            print(f"  [{i}/{len(todo)}] summarizing {p.rel} …")
            prompt = ("Summarize this documentation page in 2-3 plain sentences "
                      "for a reader deciding whether to open it. No preamble, "
                      "no markdown.\n\n# " + p.title + "\n\n" + p.md_body[:6000])
            try:
                cache[key] = post("/api/generate", {
                    "model": model, "prompt": prompt, "stream": False,
                }).get("response", "").strip()
                cache_f.write_text(jsonlib.dumps(cache))
            except OSError as exc:
                print(f"bookify: ollama error ({exc}); continuing without AI overview",
                      file=sys.stderr)
                return None
        summaries.append((p, cache[key]))

    joined = "\n".join(f"- {p.title}: {s}" for p, s in summaries)
    key = hashlib.sha1((model + "\x01" + joined).encode()).hexdigest()
    if key not in cache:
        try:
            cache[key] = post("/api/generate", {
                "model": model, "stream": False,
                "prompt": "In one short paragraph (3-4 sentences), describe what "
                          "this documentation covers overall, based on these page "
                          "summaries. No preamble.\n\n" + joined[:8000],
            }).get("response", "").strip()
            cache_f.write_text(jsonlib.dumps(cache))
        except OSError:
            cache[key] = ""
    abstract = cache[key]

    def build(links: dict) -> str:
        md = [f"# {title}: Overview", "",
              f"*Summaries generated locally by Ollama (`{model}`).*", ""]
        if abstract:
            md += [abstract, ""]
        md += ["## Pages", ""]
        for p, s in summaries:
            md += [f"### [{p.title}]({links[id(p)]})", "", s, ""]
        return "\n".join(md)

    ov = Page(src=out, rel=Path("__overview__.md"), title="Overview (AI)", kind="md")
    MD_RENDERER.reset()
    ov.html_body = MD_RENDERER.convert(
        build({id(p): str(p.out_rel_html).replace("\\", "/") for p, _ in summaries}))
    ov.md_body = build(
        {id(p): str(p.out_rel_md).replace("\\", "/") for p, _ in summaries})
    return ov


