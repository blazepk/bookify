// depth-to-root, as emitted into <body data-root>
const ROOT=document.body.dataset.root||'';
// Key annotations by the page's path *within the book*, taking the last
// depth+1 segments of the URL. The raw pathname would be an absolute
// filesystem path under file:// and would carry any mount prefix when served
// under a subpath; this way one key works everywhere, and ROOT+key is always a
// link that resolves from the current page.
const PAGE=document.body.dataset.page||(()=>{const d=ROOT.split('../').length-1;
const segs=decodeURIComponent(location.pathname).split('/').filter(Boolean);
return segs.slice(Math.max(0,segs.length-(d+1))).join('/')||'index.html'})();
