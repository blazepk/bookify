def build_tree(pages: list[Page]) -> dict:
    tree: dict = {"dirs": {}, "pages": []}
    for p in pages:
        node = tree
        for part in p.rel.parts[:-1]:
            node = node["dirs"].setdefault(part, {"dirs": {}, "pages": []})
        node["pages"].append(p)
    return tree


def nav_html(tree: dict, current: Page, depth_to_root: str) -> str:
    out = ["<ul>"]
    for p in tree["pages"]:
        active = ' class="active"' if p is current else ""
        href = depth_to_root + str(p.out_rel_html).replace("\\", "/")
        out.append(
            f'<li data-t="{html_mod.escape(p.title.lower())}">'
            f'<a href="{href}"{active}>{html_mod.escape(p.title)}</a></li>'
        )
    for name, sub in sorted(tree["dirs"].items(), key=lambda kv: kv[0].lower()):
        is_open = " open" if str(current.rel).startswith(name) or _contains(sub, current) else ""
        out.append(f"<details{is_open}><summary>{html_mod.escape(humanize(name))}</summary>")
        out.append(nav_html(sub, current, depth_to_root))
        out.append("</details>")
    out.append("</ul>")
    return "".join(out)


def _contains(tree: dict, page: Page) -> bool:
    if any(p is page for p in tree["pages"]):
        return True
    return any(_contains(sub, page) for sub in tree["dirs"].values())


