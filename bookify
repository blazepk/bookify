// ---- liveness: each tab holds an open SSE connection so `bookify` can stop
// its server when the last tab closes. A connection (unlike timers) is never
// throttled in background tabs. No-ops under file:// or other static hosts. ----
(()=>{if(location.protocol!=='http:'&&location.protocol!=='https:')return;
if(!window.EventSource)return;
let opened=false,fails=0;
const es=new EventSource('/__watch__');
es.onopen=()=>{opened=true;fails=0};
// Never connected => not bookify's server, stop at once. Connected then
// dropped => allow a few auto-reconnects (waking from sleep, a rebuild), but
// give up after that: once bookify has exited, retrying forever just hammers
// localhost and fills the console with failed requests.
es.onerror=()=>{if(!opened||++fails>5)es.close()};})();
