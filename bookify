# Book map (interactive mind-map of structure + cross-links)

def write_map_page(pages: list[Page], out: Path, title: str) -> None:
    import json as jsonlib

    nodes = [{"id": "", "label": title, "kind": "root"}]
    folders = sorted({"/".join(p.rel.parts[:i])
                      for p in pages for i in range(1, len(p.rel.parts))})
    nodes += [{"id": "dir:" + f, "label": humanize(f.rsplit("/", 1)[-1]),
               "kind": "dir"} for f in folders]
    page_ids = set()
    for p in pages:
        pid = str(p.out_rel_html).replace("\\", "/")
        page_ids.add(pid)
        nodes.append({"id": pid, "label": p.title, "kind": "page", "href": pid})

    edges = []
    for f in folders:
        parent = "dir:" + f.rsplit("/", 1)[0] if "/" in f else ""
        edges.append({"s": parent, "t": "dir:" + f, "kind": "tree"})
    for p in pages:
        pid = str(p.out_rel_html).replace("\\", "/")
        parent = "dir:" + "/".join(p.rel.parts[:-1]) if len(p.rel.parts) > 1 else ""
        edges.append({"s": parent, "t": pid, "kind": "tree"})
    seen = set()
    for p in pages:
        pid = str(p.out_rel_html).replace("\\", "/")
        base = posixpath.dirname(pid)
        for href in re.findall(r'href="([^"#]+)"', p.html_body):
            if href.startswith(("http://", "https://", "mailto:", "/", "data:")):
                continue
            t = posixpath.normpath(posixpath.join(base, href))
            if t in page_ids and t != pid and (pid, t) not in seen:
                seen.add((pid, t))
                edges.append({"s": pid, "t": t, "kind": "link"})

    graph = jsonlib.dumps({"nodes": nodes, "edges": edges})
    doc = f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Map — {html_mod.escape(title)}</title>
<link rel="icon" href="data:,"><script>{THEME_INIT}</script>
<link rel="stylesheet" href="book.css">
<style>html,body{{height:100%;overflow:hidden}}
#mapbar{{position:fixed;top:0;left:0;right:0;z-index:5;display:flex;gap:1rem;
align-items:baseline;padding:.8rem 1.2rem;font-family:var(--sans)}}
#mapbar .hint{{font-size:.74rem;color:var(--muted)}}
canvas{{display:block}}</style></head><body>
<div id="mapbar"><a href="index.html">&larr; {html_mod.escape(title)}</a>
<strong style="font-family:var(--serif)">Book map</strong>
<span class="hint">drag nodes &middot; scroll to zoom &middot; click a page to open it</span></div>
<canvas id="c"></canvas>
<script>
const G={graph};
const cv=document.getElementById('c'),ctx=cv.getContext('2d');
let W,H,DPR=devicePixelRatio||1,zoom=1,panX=0,panY=0;
function resize(){{W=innerWidth;H=innerHeight;cv.width=W*DPR;cv.height=H*DPR;
cv.style.width=W+'px';cv.style.height=H+'px'}}resize();
// setting canvas.width clears the bitmap, so a resize must repaint or the map
// goes blank until the next mouse move
onresize=()=>{{resize();wake(0.1)}};
const R={{root:16,dir:10,page:6}};
const N=G.nodes.map((n,i)=>({{...n,
x:W/2+Math.cos(i*2.4)*(60+i*7),y:H/2+Math.sin(i*2.4)*(60+i*7),vx:0,vy:0}}));
const byId=new Map(N.map(n=>[n.id,n]));
const E=G.edges.map(e=>({{s:byId.get(e.s),t:byId.get(e.t),kind:e.kind}}))
.filter(e=>e.s&&e.t);
let alpha=1;
function tick(){{
for(let i=0;i<N.length;i++)for(let j=i+1;j<N.length;j++){{
const a=N[i],b=N[j];let dx=b.x-a.x,dy=b.y-a.y,d2=dx*dx+dy*dy||1;
