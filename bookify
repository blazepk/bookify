SEARCH_HEADING = re.compile(r"<h([1-4])([^>]*)>(.*?)</h\1>", re.S | re.I)


def _plain_text(fragment: str) -> str:
    text = re.sub(r"<[^>]+>", " ", fragment)
    return re.sub(r"\s+", " ", html_mod.unescape(text)).strip()


def search_sections(body_html: str, limit: int = 40000) -> list[list[str]]:
    """A page's text split at its headings: [[heading id, heading, text], ...]."""
    body = re.sub(r"<(script|style|svg)\b[^>]*>.*?</\1>", " ", body_html, flags=re.S | re.I)
    parts: list[list[str]] = []
    pos, sid, heading = 0, "", ""
    for m in SEARCH_HEADING.finditer(body):
        text = _plain_text(body[pos:m.start()])
        if text or heading:
            parts.append([sid, heading, text])
        found = re.search(r'\bid="([^"]+)"', m.group(2))
        sid, heading, pos = (found.group(1) if found else ""), _plain_text(m.group(3)), m.end()
    tail = _plain_text(body[pos:])
    if tail or heading:
        parts.append([sid, heading, tail])
    out, budget = [], limit
    for sid, heading, text in parts:   # very long pages keep their opening sections
        out.append([sid, heading, text[:max(budget, 0)]])
        budget -= len(text)
        if budget <= 0:
            break
    return out


def write_search_index(pages: list[Page], out: Path) -> None:
    """search.js for the in-book search, as a script so it also works over file://."""
    import json as jsonlib

    docs = [{"t": p.title, "u": p.out_rel_html.as_posix(), "s": " › ".join(p.section),
             "p": search_sections(p.html_body)} for p in pages]
    (out / "search.js").write_text(
        "window.BOOKIFY_SEARCH=" + jsonlib.dumps(docs, ensure_ascii=False, separators=(",", ":")) + ";\n",
        encoding="utf-8")


