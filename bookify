def main() -> int:
    global ASK_TIMEOUT
    # progress/banner lines should appear as they happen even when the output is
    # piped or redirected (an agent, `| tee`), not all at once on exit
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, OSError):
        pass
    ap = argparse.ArgumentParser(
        prog="bookify",
        description="Render a folder's docs as a browsable book (HTML + Markdown).")
    ap.add_argument("folder", nargs="?", default=".",
                    help="folder to render (default: current directory)")
    ap.add_argument("-o", "--out", default=None,
                    help="output dir (default: ~/.cache/bookify/<name>-<hash>, "
                         "kept outside the scanned folder)")
    ap.add_argument("--format", choices=["html", "md", "both"], default="both")
    ap.add_argument("--title", default=None, help="book title (default: folder name)")
    ap.add_argument("--include-code", action="store_true",
                    help="also render source-code files as highlighted pages")
    ap.add_argument("--serve", nargs="?", const=8123, default=8123, type=int,
                    metavar="PORT",
                    help="port to serve the HTML book on (default 8123; serving "
                         "is on by default)")
    ap.add_argument("--no-serve", action="store_true",
                    help="build only, don't start the local server")
    ap.add_argument("--keep-alive", action="store_true",
                    help="keep serving even after all browser tabs are closed")
    ap.add_argument("--ai", nargs="?", const=AI_DEFAULT_MODEL, default=None,
                    metavar="MODEL",
                    help="add an AI-generated overview page via local Ollama "
                         f"(default model: {AI_DEFAULT_MODEL})")
    ap.add_argument("--ask-model", default=AI_DEFAULT_MODEL, metavar="MODEL",
                    help="Ollama model to prefer for Ask AI "
                         f"(default: {AI_DEFAULT_MODEL})")
    ap.add_argument("--ask-provider", default=None, metavar="ID",
                    help="force one Ask AI backend (ollama, claude, codex, "
                         "gemini) instead of auto-detecting")
    ap.add_argument("--ask-timeout", type=int, default=ASK_TIMEOUT, metavar="SEC",
                    help=f"per-answer time limit for Ask AI (default {ASK_TIMEOUT})")
    ap.add_argument("--no-ask", action="store_true",
                    help="disable the Ask AI sidebar")
    args = ap.parse_args()

    ASK_TIMEOUT = max(10, args.ask_timeout)

    root = Path(args.folder).expanduser().resolve()
    # identifies this book in the browser's IndexedDB. Derived from the source
    # path so it survives rebuilds, a different --serve port and a new --title.
    book_id = hashlib.sha1(str(root).encode()).hexdigest()[:16]
    if not root.is_dir():
        print(f"bookify: not a directory: {root}", file=sys.stderr)
        return 1
    if args.out:
        out = Path(args.out).expanduser().resolve()
    else:
        tag = book_id[:8]
        out = Path.home() / ".cache" / "bookify" / f"{root.name}-{tag}"
    title = args.title or root.name

    pages = [p for p in collect_pages(root, args.include_code)
             if out not in p.src.parents]
    if not pages:
        print("bookify: no documentation files found "
              "(try --include-code to render source files too)", file=sys.stderr)
        return 1
    print(f"Navigation:    {arrange(pages, root)}")
    link_pages(pages)

    html_map, md_map = build_link_maps(pages)
    links = WikiLinks(pages, root)
    templates = Templates(root, links.index)
    for p in pages:
        render_page(p, html_map, md_map, links, templates)

    # wipe + rebuild the output, carrying user data (notes, AI cache) across
    preserved = {}
    for name in ("annotations.json", "ai-cache.json"):
        f = out / name
        if f.exists():
            preserved[name] = f.read_bytes()
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True, exist_ok=True)
    # local-use artifacts: keep git blind to them even if -o points inside a repo
    (out / ".gitignore").write_text("*\n", encoding="utf-8")
    for name, data in preserved.items():
        (out / name).write_bytes(data)

    if args.ai:
        overview = ai_overview(pages, out, title, args.ai)
        if overview:
            pages.insert(0, overview)
            for p in pages:
                p.prev = p.next = None
            for a, b in zip(pages, pages[1:]):
                a.next, b.prev = b, a

    tree = build_tree(pages)
    dests = []
    if args.format in ("html", "both"):
        write_html_book(pages, tree, out / "html", title, book_id)
        write_map_page(pages, out / "html", title)
        write_search_index(pages, out / "html")
        dests.append(out / "html")
        print(f"HTML book:     {out / 'html' / 'index.html'}")
    if args.format in ("md", "both"):
        write_md_book(pages, out / "markdown", title)
        dests.append(out / "markdown")
        print(f"Markdown book: {out / 'markdown' / 'SUMMARY.md'}")
    # images/diagrams the pages point at, so they aren't broken in the output
    n_assets = copy_assets(collect_assets(pages, root), *dests) if dests else 0
    print(f"{len(pages)} pages rendered"
          + (f", {n_assets} assets copied." if n_assets else "."))

    if not args.no_serve and args.format in ("html", "both"):
        import functools
        import http.server
        import secrets
        import threading
        import time
        import webbrowser

        import json as jsonlib

        state = {"conns": 0}   # open SSE connections == open tabs
        lock = threading.Lock()
        seen_any = threading.Event()
        ann_path = out / "annotations.json"   # preserved across rebuilds
        ann_lock = threading.Lock()
        # A random per-run token, handed out by GET /__ask__ (readable only by
        # same-origin script) and required on POST. Ask AI shells out to local
        # assistant CLIs, so no other page in the browser gets to trigger it.
        ask_token = secrets.token_urlsafe(24)
        ask_state = {"providers": None, "at": 0.0}

        def ask_providers(force: bool = False) -> list:
            now = time.monotonic()
            if force or ask_state["providers"] is None or now - ask_state["at"] > 20:
                provs = detect_providers(args.ask_model)
                if args.ask_provider:
                    provs = [p for p in provs if p["id"] == args.ask_provider]
                ask_state["providers"] = provs
                ask_state["at"] = now
            return ask_state["providers"]

        def prune_tombstones(items):
            """Keep deletions long enough to reach every store, then forget them.

            A delete has to be recorded, not just omitted: the browser's
            IndexedDB copy and this file sync both ways, and a missing record
            is indistinguishable from one the other side has not seen yet, so
            dropping it outright would let a deleted note come back.
            """
            if not isinstance(items, list):
                return []
            cutoff = (time.time() - TOMBSTONE_TTL) * 1000
            out = []
            for a in items:
                if not isinstance(a, dict) or not a.get("id"):
                    continue
                if a.get("deleted") and (a.get("updated") or a.get("ts") or 0) < cutoff:
                    continue
                out.append(a)
            return out

        def read_annotations() -> dict:
            try:
                db = jsonlib.loads(ann_path.read_bytes())
                if isinstance(db, dict) and isinstance(db.get("pages"), dict):
                    return db
            except (OSError, ValueError):
                pass
            return {"version": 1, "pages": {}}

        def save_annotations(payload: dict) -> dict:
            """Apply one write and return the resulting store.

            `{"merge": {page: [...]}}` touches only the named pages, so two tabs
            annotating different pages no longer overwrite each other; a whole
            `{"pages": {...}}` body still replaces the store outright. Written
            via a temp file + rename so an interrupted write can't truncate the
            notes that are already saved.
            """
            with ann_lock:
                if isinstance(payload.get("merge"), dict):
                    db = read_annotations()
                    for page, items in payload["merge"].items():
                        items = prune_tombstones(items)
                        if items:
                            db["pages"][str(page)] = items
                        else:
                            db["pages"].pop(str(page), None)
                elif isinstance(payload.get("pages"), dict):
                    db = {"version": 1, "pages": {
                        k: prune_tombstones(v)
                        for k, v in payload["pages"].items()}}
                    db["pages"] = {k: v for k, v in db["pages"].items() if v}
                else:
                    raise ValueError("expected 'merge' or 'pages'")
                tmp = ann_path.with_suffix(".json.tmp")
                tmp.write_text(jsonlib.dumps(db), encoding="utf-8")
                tmp.replace(ann_path)
                return db

        class BookHandler(http.server.SimpleHTTPRequestHandler):
            def do_GET(self):
                if self.path.startswith("/__annotations__"):
                    body = jsonlib.dumps(read_annotations()).encode()
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if self.path.startswith("/__ask__"):
                    provs = [] if args.no_ask else ask_providers()
                    usable = [p for p in provs if not p.get("unavailable")]
                    self.send_json({
                        "ok": bool(usable),
                        "token": ask_token,
                        "providers": provs,
                        "default": (usable[0]["id"] if usable else None),
                        "reason": ("Ask AI is disabled (--no-ask)" if args.no_ask
                                   else "" if usable else
                                   "No local assistant found. Install Ollama "
                                   f"(ollama pull {AI_DEFAULT_MODEL}) or a CLI "
                                   "such as claude, codex or gemini."),
                    })
                    return
                if self.path.startswith("/__watch__"):
                    self.close_connection = True
                    self.send_response(200)
                    self.send_header("Content-Type", "text/event-stream")
                    self.send_header("Cache-Control", "no-store")
                    self.end_headers()
                    with lock:
                        state["conns"] += 1
                    seen_any.set()
                    try:
                        # periodic ping so a vanished client (closed tab,
                        # killed browser) surfaces as a broken pipe
                        while True:
                            self.wfile.write(b": ping\n\n")
                            self.wfile.flush()
                            time.sleep(5)
                    except OSError:
                        pass
                    finally:
                        with lock:
                            state["conns"] -= 1
                    return
                super().do_GET()

            def send_json(self, obj, code: int = 200):
                body = jsonlib.dumps(obj).encode()
                self.send_response(code)
                self.send_header("Content-Type", "application/json")
                self.send_header("Cache-Control", "no-store")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)

            def do_POST(self):
                if self.path.startswith("/__ask__"):
                    self.do_ask()
                    return
                if self.path.startswith("/__annotations__"):
                    n = int(self.headers.get("Content-Length") or 0)
                    if n > 2_000_000:
                        self.send_response(413)
                        self.end_headers()
                        return
                    raw = self.rfile.read(n) if n > 0 else b""
                    try:
                        payload = jsonlib.loads(raw or b"{}")
                        if not isinstance(payload, dict):
                            raise ValueError("not an object")
                        body = jsonlib.dumps(save_annotations(payload)).encode()
                    except ValueError:
                        self.send_response(400)
                        self.end_headers()
                        return
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Cache-Control", "no-store")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
                    return
                self.send_response(404)
                self.end_headers()

            def do_ask(self):
                n = int(self.headers.get("Content-Length") or 0)
                if args.no_ask:
                    self.send_json({"error": "Ask AI is disabled"}, 403)
                    return
                if n <= 0 or n > 1_000_000:
                    self.send_json({"error": "bad request"}, 400)
                    return
                try:
                    payload = jsonlib.loads(self.rfile.read(n))
                    if not isinstance(payload, dict):
                        raise ValueError
                except ValueError:
                    self.send_json({"error": "bad json"}, 400)
                    return
                if not secrets.compare_digest(str(payload.get("token") or ""), ask_token):
                    self.send_json({"error": "bad token"}, 403)
                    return
                provs = {p["id"]: p for p in ask_providers()}
                pid = str(payload.get("provider") or "")
                prov = provs.get(pid)
                if prov is None or prov.get("unavailable"):
                    self.send_json({"error": (prov or {}).get("unavailable")
                                    or f"provider '{pid}' is not available"}, 400)
                    return

                # stream NDJSON: {"t": ...} chunks, then {"done": true}
                self.close_connection = True
                self.send_response(200)
                self.send_header("Content-Type", "application/x-ndjson")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                stop = {"kill": None}

                def emit(obj):
                    self.wfile.write((jsonlib.dumps(obj) + "\n").encode())
                    self.wfile.flush()

                try:
                    if pid == "ollama":
                        stream_ollama(payload, prov.get("detail") or args.ask_model, emit)
                    else:
                        stream_cli(payload, pid, emit, stop)
                    emit({"done": True})
                except OSError:
                    # reader went away (Stop, closed tab): stop the child too
                    if stop["kill"]:
                        stop["kill"]()
                except Exception as exc:               # noqa: BLE001
                    try:
                        emit({"error": f"{type(exc).__name__}: {exc}"[:500]})
                    except OSError:
                        pass

            def log_request(self, *a, **kw):
                if not self.path.startswith(("/__watch__", "/__annotations__",
                                             "/__ask__")):
                    super().log_request(*a, **kw)

        handler = functools.partial(BookHandler, directory=str(out / "html"))
        server = None
        for port in range(args.serve, args.serve + 20):
            try:
                server = http.server.ThreadingHTTPServer(("127.0.0.1", port), handler)
                break
            except OSError:
                continue
        if server is None:
            print(f"bookify: no free port in {args.serve}-{args.serve + 19}",
                  file=sys.stderr)
            return 1
        if not args.no_ask:
            provs = detect_providers(args.ask_model)
            if args.ask_provider:
                provs = [p for p in provs if p["id"] == args.ask_provider]
            usable = [p for p in provs if not p.get("unavailable")]
            if usable:
                print("Ask AI:        " + ", ".join(
                    f"{p['label']} ({p['detail']})" for p in usable)
                    + f"  — using {usable[0]['label']}")
            else:
                print("Ask AI:        no local assistant detected "
                      f"(ollama pull {AI_DEFAULT_MODEL}, or install claude/codex/gemini)")
        url = f"http://localhost:{server.server_address[1]}"
        if args.keep_alive:
            print(f"Serving at {url} (Ctrl-C to stop)")
        else:
            print(f"Serving at {url} — stops automatically when all tabs close "
                  f"(or Ctrl-C)")

            def watchdog():
                seen_any.wait()  # don't shut down before the browser ever connects
                last_alive = time.monotonic()
                while True:
                    time.sleep(1)
                    with lock:
                        n = state["conns"]
                    now = time.monotonic()
                    if n > 0:
                        last_alive = now
                    elif now - last_alive > 6:  # grace covers refresh/navigation
                        print("All tabs closed — stopping server.")
                        server.shutdown()
                        return

            threading.Thread(target=watchdog, daemon=True).start()
        webbrowser.open(url)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
