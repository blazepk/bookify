// last write wins per annotation id; a tombstone beats a live record on a tie,
// so a delete is never resurrected by whichever store is behind
function newest(a,b){if(!a)return b;if(!b)return a;
const ta=a.updated||a.ts||0,tb=b.updated||b.ts||0;
if(ta!==tb)return ta>tb?a:b;
