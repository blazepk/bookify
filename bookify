#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "markdown>=3.5",
#   "pygments>=2.17",
#   "docutils>=0.20",
#   "pymdown-extensions>=10.0",
#   "pyyaml>=6.0",
# ]
