@dataclass
class Page:
    src: Path            # absolute source path
    rel: Path            # path relative to the root folder
    title: str = ""
    kind: str = "md"     # md | rst | html | text | code
    lang: str = ""       # pygments hint for code files
    order: float = float("inf")  # front-matter position (sidebar_position, weight, ...)
    section: tuple = ()  # sidebar section labels, outermost first
    meta: dict = field(default_factory=dict, repr=False, compare=False)  # front matter
    html_body: str = ""
    md_body: str = ""
    # prev/next are cyclic and link_* are derived: comparing them would make
    # Page.__eq__ recurse through the whole book
    prev: "Page | None" = field(default=None, repr=False, compare=False)
    next: "Page | None" = field(default=None, repr=False, compare=False)
    _out_html: "Path | None" = field(default=None, repr=False, compare=False)
    _out_md: "Path | None" = field(default=None, repr=False, compare=False)

    @property
    def out_rel_html(self) -> Path:
        if self._out_html:
            return self._out_html
        return self.default_out_html

    @property
    def default_out_html(self) -> Path:
        if self.kind == "html":
            return self.rel  # keep the original path so existing .html links still work
        if self.kind == "code":
            return self.rel.with_suffix(self.rel.suffix + ".html")
        return self.rel.with_suffix(".html")

    @property
    def out_rel_md(self) -> Path:
        if self._out_md:
            return self._out_md
        return self.default_out_md

    @property
    def default_out_md(self) -> Path:
        if self.kind == "md":
            return self.rel.with_suffix(".md")
        return self.rel.with_suffix(self.rel.suffix + ".md")


def first_heading(text: str) -> str | None:
    for line in text.splitlines():
        m = re.match(r"^#{1,6}\s+(.*)", line)
        if m:
            return re.sub(r"[#*`_\[\]]", "", m.group(1)).strip()
    return None


RST_ADORNMENT = re.compile(r"([=\-~^*#+`:'\"._])\1{2,}")


def rst_title(text: str) -> str | None:
    """The first reStructuredText section title: a line underlined at least as long."""
    lines = text.splitlines()
    for line, under in zip(lines, lines[1:]):
        s, u = line.strip(), under.rstrip()
        if (s and line[:1] not in (" ", "\t") and not RST_ADORNMENT.fullmatch(s)
                and RST_ADORNMENT.fullmatch(u) and len(u) >= len(s)):
            return s
    return None


FRONT_MATTER = re.compile(
    r"\A﻿?(---|\+\+\+)[ \t]*\r?\n(.*?)\r?\n\1[ \t]*(?:\r?\n|\Z)", re.S)
FRONT_MATTER_KEY = re.compile(r"^([A-Za-z_][\w-]*)[ \t]*[:=][ \t]*(.*)$")
# keys docs generators use to place a page in their sidebar, most specific first
ORDER_KEYS = ("sidebar_position", "nav_order", "weight", "order", "position")


def split_front_matter(text: str) -> tuple[dict[str, str], str]:
    """Separate YAML (`---`) or TOML (`+++`) front matter from the page body.

    Docusaurus, Hugo, Jekyll, VitePress, Astro and MkDocs Material keep page
    metadata there; left in, it renders as a stray rule over a run-on paragraph.
    Only top-level scalar keys are read — enough for the title and sidebar
    order without pulling in a YAML parser.
    """
    m = FRONT_MATTER.match(text)
    if not m:
        return {}, text
    meta: dict[str, str] = {}
    for line in m.group(2).splitlines():
        km = FRONT_MATTER_KEY.match(line)
        if not km:
            continue
        value = km.group(2).strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        if value and value not in ("|", ">", "|-", ">-"):
            meta[km.group(1).lower()] = value
    if not meta:   # a leading horizontal rule, not metadata
        return {}, text
    return meta, text[m.end():]


def front_matter_order(meta: dict[str, str]) -> float:
    for key in ORDER_KEYS:
        try:
            return float(meta[key])
        except (KeyError, ValueError):
            continue
    return float("inf")


FENCE = re.compile(r"^[ \t]*(`{3,}|~{3,})")
FENCE_INFO = re.compile(r"^([ \t]*)(`{3,}|~{3,})[ \t]*([^\s`{]*)(.*)$")
CALLOUT_OPEN = re.compile(
    r"^[ \t]*:{3,}[ \t]*([A-Za-z][\w-]*)(?:\[([^\]]*)\])?[ \t]*(.*?)[ \t]*$")
CALLOUT_CLOSE = re.compile(r"^[ \t]*:{3,}[ \t]*$")
# > [!NOTE] (GitHub), > [!tip]- Title (Obsidian: +/- make it foldable, open or closed)
GITHUB_ALERT = re.compile(r"^>[ \t]*\[!([A-Za-z][\w-]*)\]([+-]?)[ \t]*(.*)$")
DETAILS_OPEN = re.compile(r"^\s*<details(\s[^>]*)?>\s*$", re.I)
FULL_EMBED = re.compile(r"^\s*!\[\[([^\[\]\n]+?)\]\]\s*$")
MDX_ESM = re.compile(r"^(?:import|export)\s")


_INLINE_MD: "md_lib.Markdown | None" = None


def inline_html(text: str) -> str:
    """One line of inline Markdown as HTML, without the paragraph around it —
    for titles that sit inside raw HTML, where Markdown isn't processed."""
    global _INLINE_MD
    if _INLINE_MD is None:
        _INLINE_MD = md_lib.Markdown(extensions=["pymdownx.tilde", "pymdownx.mark"],
                                     extension_configs={"pymdownx.tilde": {"subscript": False}})
    _INLINE_MD.reset()
    return re.sub(r"^<p>(.*)</p>$", r"\1", _INLINE_MD.convert(text.strip()), flags=re.S)


def _label(kind: str, title_html: str) -> str:
    return title_html.strip() or html_mod.escape(kind.capitalize())


def _callout(kind: str, title_html: str) -> list[str]:
    # md_in_html (part of "extra") renders the Markdown inside the div, fenced
    # code included; the classes match what the admonition extension emits
    kind = kind.lower()
    return ["", f'<div class="admonition {kind}" markdown="1">',
            f'<p class="admonition-title">{_label(kind, title_html)}</p>', ""]


def _foldable(kind: str, title_html: str, open_: bool) -> list[str]:
    kind = kind.lower()
    label = _label(kind, title_html)
    return ["", f'<details class="admonition {kind}"{" open" if open_ else ""} markdown="1">',
            f"<summary>{label}</summary>", ""]


def _nesting(line: str) -> int:
    return sum(line.count(c) for c in "{([") - sum(line.count(c) for c in "})]")


def normalize_markdown(text: str, mdx: bool = False, callouts: bool = True,
                       links: "WikiLinks | None" = None, page: "Page | None" = None) -> str:
    """Rewrite other docs systems' Markdown dialects into what the renderer knows.

    - `:::tip Title` … `:::` containers (Docusaurus, VitePress, Starlight)
    - `> [!NOTE]` alerts (GitHub, Obsidian)
    - MDX `import`/`export` statements, which are build-time code, not prose
    Fenced code blocks pass through untouched, so documented examples of these
    syntaxes still show up as code.
    """
    lines = text.split("\n")
    out: list[str] = []
    fence = ""
    esm_depth = 0
    open_callouts = 0
    transclusions = 0
    base = posixpath.dirname(page.rel.as_posix()) if page else ""

    def wl(s: str) -> str:
        return links.inline(s, base) if links and "[[" in s else s

    def title(s: str) -> str:
        return inline_html(wl(s)) if s and s.strip() else ""

    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        if fence:
            out.append(line)
            stripped = line.strip()
            if stripped.startswith(fence) and not stripped.lstrip(fence[0]):
                fence = ""
            continue
        if esm_depth > 0:   # inside a multi-line import/export
            esm_depth = max(0, esm_depth + _nesting(line))
            continue
        m = FENCE_INFO.match(line)
        if m:
            indent, fence, lang, info = m.groups()
            named = re.search(r"""title=["']([^"']+)["']""", info)
            if named and callouts:   # Docusaurus, Starlight and Material name code blocks
                out += ["", f'{indent}<p class="code-title">{html_mod.escape(named.group(1))}</p>']
            # keep only the language: line ranges and flags ({1,3}, showLineNumbers, ins={2})
            # aren't understood and would stop the fence from being recognised at all
            out.append(f"{indent}{fence}{lang}" if callouts else line)
            continue
        if mdx and MDX_ESM.match(line):
            esm_depth = max(0, _nesting(line))
            continue
        if callouts and DETAILS_OPEN.match(line) and "markdown=" not in line:
            # a raw <details> block would otherwise print its Markdown unrendered
            line = re.sub(r"<details", '<details markdown="1"', line, count=1, flags=re.I)
        if callouts and links and transclusions < 25:
            em = FULL_EMBED.match(line)
            inserted = links.transclude(em.group(1), base, page) if em else None
            if inserted is not None:   # ![[Note#Section]] on its own line shows that note
                transclusions += 1
                lines[i:i] = inserted
                continue
        if callouts:
            m = CALLOUT_OPEN.match(line)
            if m:
                out += _callout(m.group(1), title(m.group(2) or m.group(3)))
                open_callouts += 1
                continue
            if open_callouts and CALLOUT_CLOSE.match(line):
                out += ["", "</div>", ""]
                open_callouts -= 1
                continue
            m = GITHUB_ALERT.match(line)
            if m:
                kind, fold, label = m.group(1), m.group(2), title(m.group(3))
                body = []
                while i < len(lines) and lines[i].startswith(">"):
                    body.append(wl(re.sub(r"^>[ \t]?", "", lines[i])))
                    i += 1
                if fold:
                    out += _foldable(kind, label, fold == "+") + body + ["", "</details>", ""]
                else:
                    out += _callout(kind, label) + body + ["", "</div>", ""]
                continue
        out.append(wl(line))
    out += ["", "</div>"] * open_callouts   # an unclosed container ends with the page
    return "\n".join(out)


def html_title(text: str) -> str | None:
    m = re.search(r"<title[^>]*>(.*?)</title>", text, re.I | re.S) or \
        re.search(r"<h1[^>]*>(.*?)</h1>", text, re.I | re.S)
    if m:
        t = html_mod.unescape(re.sub(r"<[^>]+>", "", m.group(1))).strip()
        return t or None
    return None


NUMBER_PREFIX = re.compile(r"^(\d+)[-_. ]+(?=\S)")


def humanize(name: str, is_dir: bool = False) -> str:
    stem = name if is_dir else Path(name).stem
    # Docusaurus-style "01-intro" is ordered by the number and labelled by the rest
    stem = NUMBER_PREFIX.sub("", stem) or stem
    words = re.sub(r"[-_]+", " ", stem).split()
    # capitalise without lowercasing the rest, so "API" and "iOS" survive
    return " ".join(w[:1].upper() + w[1:] for w in words) or name


def fallback_title(rel: Path) -> str:
    """A name for a page without a title of its own; index pages take their folder's."""
    if rel.stem.lower() in ("index", "readme", "_index"):
        return humanize(rel.parent.name, is_dir=True) if rel.parent.parts else "Home"
    return humanize(rel.name)


def natural(s: str) -> tuple:
    """Case-insensitive, with digit runs compared as numbers: page2 before page10."""
    return tuple(int(t) if t.isdigit() else t for t in re.split(r"(\d+)", s.lower()))


def sort_key(p: Path, order: float = float("inf")) -> tuple:
    """README/index first, then front-matter order, then case-insensitive alphabetical."""
    stem = p.stem.lower()
    return (0 if stem in ("readme", "index", "home", "_index") else 1, order,
            natural(p.as_posix()))


def collect_pages(root: Path, include_code: bool) -> list[Page]:
    pages: list[Page] = []
    skip = SKIP_DIRS | (JEKYLL_INTERNALS if (root / "_config.yml").is_file() else set())
    if (root / ".vitepress").is_dir():
        skip = skip | {"public"}   # VitePress copies public/ verbatim; it holds no pages
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        if any(part in skip or part.startswith(".") for part in path.relative_to(root).parts[:-1]):
            continue
        name = path.name
        if name.startswith(".") and name.lower() != ".env.example":
            continue
        ext = path.suffix.lower()
        kind = lang = None
        if ext in DOC_EXTS:
            kind = "md" if ext in MD_EXTS else "rst" if ext == ".rst" else "text"
        elif ext in HTML_EXTS:
            kind = "html"
        elif name.lower() in ("dockerfile", "makefile", "justfile"):
            if include_code:
                kind, lang = "code", {"dockerfile": "dockerfile", "makefile": "makefile", "justfile": "makefile"}[name.lower()]
        elif ext in CODE_EXTS:
            if include_code:
                kind, lang = "code", CODE_EXTS[ext]
        if kind is None:
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        rel = path.relative_to(root)
        order = float("inf")
        meta: dict[str, str] = {}
        if kind == "md":
            meta, body = split_front_matter(text)
            title = meta.get("title") or first_heading(body) or fallback_title(rel)
            order = front_matter_order(meta)
        elif kind == "rst":
            title = rst_title(text) or fallback_title(rel)
        elif kind == "html":
            meta, body = split_front_matter(text)
            title = meta.get("title") or html_title(body) or fallback_title(rel)
        elif kind == "code":
            title = name  # keep exact filename for code pages
        else:
            title = humanize(name)
        pages.append(Page(src=path, rel=rel, title=title, kind=kind, lang=lang or "",
                          order=order, meta=meta))

    pages.sort(key=lambda p: (tuple(str(x).lower() for x in p.rel.parts[:-1]),
                              sort_key(p.rel, p.order)))
    assign_out_paths(pages)
    for a, b in zip(pages, pages[1:]):
        a.next, b.prev = b, a
    return pages


def assign_out_paths(pages: list[Page]) -> None:
    """Give every page a unique output path in each book.

    Without this, sibling sources that differ only by extension (the common
    `README.md` + `README.rst` pair, say) both want `README.html` and one
    silently overwrites the other. HTML sources keep their exact path so
    hand-written .html links keep resolving; everyone else yields to them and
    then to whoever claimed the name first (page order is stable, so README.md
    keeps README.html and the .rst becomes README.rst.html).
    """
    for attr, default_attr, suffix in (("_out_html", "default_out_html", ".html"),
                                       ("_out_md", "default_out_md", ".md")):
        taken: set[Path] = {p.default_out_html for p in pages if p.kind == "html"} \
            if attr == "_out_html" else set()
        for p in pages:
            if attr == "_out_html" and p.kind == "html":
                continue
            cand = getattr(p, default_attr)
            if cand in taken:
                # disambiguate by keeping the source extension: foo.rst -> foo.rst.html
                cand = p.rel.with_suffix(p.rel.suffix + suffix)
            base, n = cand, 2
            while cand in taken:
                cand = base.with_name(f"{base.stem}-{n}{base.suffix}")
                n += 1
            taken.add(cand)
            setattr(p, attr, cand)


# ----------------------------------------------------------------------------
# Navigation: reading order and sidebar sections

def load_yaml(text: str):
    """YAML that tolerates tags it doesn't know (MkDocs' !!python/name, !ENV, ...)."""
    import yaml

    class Loader(yaml.SafeLoader):
        pass

    Loader.add_multi_constructor("", lambda loader, suffix, node: None)
    return yaml.load(text, Loader=Loader)


def _as_order(value) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return float("inf")


def dir_meta(root: Path, rel_dir: Path) -> tuple[float, str]:
    """(order, label) for a folder, from the metadata docs systems keep beside it.

    Docusaurus: _category_.json / _category_.yml (position, label).
    Hugo: the section's _index.md front matter (weight, linkTitle or title).
    Otherwise a number prefix ("02-guides") orders it and its name labels it.
    """
    import json as jsonlib

    folder = root / rel_dir
    order, label = float("inf"), ""
    for name in ("_category_.json", "_category_.yml", "_category_.yaml"):
        f = folder / name
        if not f.is_file():
            continue
        try:
            text = f.read_text(encoding="utf-8", errors="replace")
            data = jsonlib.loads(text) if name.endswith(".json") else load_yaml(text)
        except Exception:   # a malformed category file shouldn't sink the build
            data = None
        if isinstance(data, dict):
            label = str(data.get("label") or "")
            order = _as_order(data.get("position"))
        break
    index = folder / "_index.md"
    if index.is_file():
        meta, _ = split_front_matter(index.read_text(encoding="utf-8", errors="replace"))
        label = label or meta.get("linktitle") or meta.get("title") or ""
        if order == float("inf"):
            order = front_matter_order(meta)
    m = NUMBER_PREFIX.match(rel_dir.name)
    if order == float("inf") and m:
        order = float(m.group(1))
    return order, label or humanize(rel_dir.name, is_dir=True)


def arrange_by_folders(pages: list[Page], root: Path) -> None:
    """The default reading order: folders and pages sorted the way docs systems do."""
    metas: dict[Path, tuple[float, str]] = {}

    def folders(p: Page) -> list[Path]:
        return [Path(*p.rel.parts[:i]) for i in range(1, len(p.rel.parts))]

    def meta(d: Path) -> tuple[float, str]:
        if d not in metas:
            metas[d] = dir_meta(root, d)
        return metas[d]

    for p in pages:
        p.section = tuple(meta(d)[1] for d in folders(p))
    pages.sort(key=lambda p: (tuple((meta(d)[0], natural(d.name)) for d in folders(p)),
                              sort_key(p.rel, p.order)))


def link_pages(pages: list[Page]) -> None:
    for p in pages:
        p.prev = p.next = None
    for a, b in zip(pages, pages[1:]):
        a.next, b.prev = b, a


@dataclass
class NavItem:
    """One entry in a docs system's own navigation config."""
    title: str = ""
    target: str = ""              # how the config names the page: path, doc id, slug, URL
    children: list = field(default_factory=list)
    expand: "str | None" = None   # a folder whose pages are listed in folder order


URL_SCHEME = re.compile(r"^[a-z][a-z0-9+.-]*:", re.I)


class PageIndex:
    """Finds a page however a nav config or a link names it.

    Configs point at pages by source path (MkDocs, mdBook), path without an
    extension (Sphinx docnames, VitePress links), Docusaurus doc id, Starlight
    slug, or published URL (Jekyll permalinks, Docusaurus slugs).
    """

    def __init__(self, pages: list[Page]):
        self.pages = pages
        self.exact: dict[str, Page] = {}
        self.alias: dict[str, Page] = {}
        self.by_stem: dict[str, list[Page]] = {}
        for p in pages:
            self.exact.setdefault(p.rel.as_posix().lower(), p)
        for p in pages:
            for name in self._aliases(p):
                self.alias.setdefault(self.norm(name), p)
            self.by_stem.setdefault(p.rel.stem.lower(), []).append(p)

    @staticmethod
    def norm(name: str) -> str:
        name = unquote(name.split("#", 1)[0].split("?", 1)[0]).strip().strip("/")
        low = name.lower()
        for ext in (".html", ".htm", ".mdx", ".md", ".markdown", ".rst"):
            if low.endswith(ext):
                name = name[: -len(ext)]
                break
        parts = name.split("/")
        if len(parts) > 1 and parts[-1].lower() in ("index", "readme", "_index"):
            parts = parts[:-1]
        elif parts[-1].lower() in ("index", "readme", "_index"):
            parts = [""]
        return "/".join(parts).lower()

    @staticmethod
    def _aliases(p: Page) -> list[str]:
        no_ext = posixpath.splitext(p.rel.as_posix())[0]
        segs = no_ext.split("/")
        stripped = "/".join(NUMBER_PREFIX.sub("", s) or s for s in segs)
        names = [no_ext, stripped]
        if segs[0].startswith("_") and len(segs) > 1:   # a Jekyll collection: _docs/x -> docs/x
            names.append("/".join([segs[0][1:], *segs[1:]]))
        if p.meta.get("id"):                             # Docusaurus doc id replaces the file name
            names.append(posixpath.join(posixpath.dirname(stripped), p.meta["id"]))
        names += [p.meta[k] for k in ("slug", "permalink", "url") if p.meta.get(k)]
        return names

    def find(self, target: str, base: str = "") -> "Page | None":
        if not target or URL_SCHEME.match(target):
            return None
        raw = unquote(target.split("#", 1)[0].split("?", 1)[0]).strip()
        if not raw:
            return None
        tries = []
        if base and not raw.startswith("/"):
            tries.append(posixpath.normpath(posixpath.join(base, raw)))
        tries.append(posixpath.normpath(raw.lstrip("/") or "."))
        for t in tries:
            if t.lower() in self.exact:
                return self.exact[t.lower()]
        for t in tries:
            hit = self.alias.get(self.norm(t))
            if hit:
                return hit
        return None


def apply_outline(pages: list[Page], items: list[NavItem], index: PageIndex) -> int:
    """Order and section pages by a nav config. Pages it doesn't mention keep
    their folder order after the listed ones. Returns how many pages it placed."""
    placed: dict[int, tuple] = {}

    def place(p: Page, section: tuple, title: str) -> None:
        if id(p) not in placed:
            placed[id(p)] = (len(placed), section, title)

    def walk(entries: list[NavItem], section: tuple) -> None:
        for it in entries:
            if it.expand is not None:
                prefix = it.expand.strip("/")
                depth = len(prefix.split("/")) if prefix else 0
                inner = section + ((it.title,) if it.title else ())
                for p in pages:
                    if not prefix or p.rel.as_posix().startswith(prefix + "/"):
                        place(p, inner + p.section[depth:], "")
                continue
            page = index.find(it.target) if it.target else None
            if it.children:
                label = it.title or (page.title if page else "")
                inner = section + (label,) if label else section
                if page:   # the label names the section; the page keeps its own heading
                    place(page, inner, "")
                walk(it.children, inner)
            elif page:
                place(page, section, it.title)

    walk(items, ())
    listed = sorted((p for p in pages if id(p) in placed), key=lambda p: placed[id(p)][0])
    for p in listed:
        _, p.section, title = placed[id(p)]
        if title:
            p.title = title
    rest = [p for p in pages if id(p) not in placed]
    # a config listing pages from a single folder (VitePress's en/) serves that folder
    # as the site root, so pages it leaves out don't sit under it either
    tops = {p.rel.parts[0] for p in listed if len(p.rel.parts) > 1}
    if len(tops) == 1 and all(len(p.rel.parts) > 1 for p in listed):
        top = next(iter(tops))
        for p in rest:
            if len(p.rel.parts) > 1 and p.rel.parts[0] == top and p.section:
                p.section = p.section[1:]
    # a home page the sidebar leaves out (Starlight, Jekyll, VitePress's en/) still opens the book
    home = sorted((p for p in rest if len(p.rel.parts) <= 2
                   and p.rel.stem.lower() in ("index", "readme")),
                  key=lambda p: len(p.rel.parts))[:1]
    for h in home:
        h.section = ()
        if h.title == fallback_title(h.rel):   # "En" for VitePress's en/index.md says nothing
            h.title = "Home"
    pages[:] = home + listed + [p for p in rest if all(p is not h for h in home)]
    return len(listed)


JS_TOKEN = re.compile(r"""
    (?P<ws>\s+|//[^\n]*|/\*.*?\*/)
  | (?P<str>'(?:\\.|[^'\\\n])*'|"(?:\\.|[^"\\\n])*"|`(?:\\.|[^`\\])*`)
  | (?P<num>\d+(?:\.\d+)?)
  | (?P<spread>\.\.\.)
  | (?P<name>[A-Za-z_$][\w$]*)
  | (?P<punct>[{}\[\]():,=;<>])
  | (?P<other>.)
""", re.S | re.X)


class JSLiteral:
    """Reads the object and array literals of a JS/TS config file without running it.

    Values it can't know statically (variables, calls, spreads) come back as None,
    so a sidebar that is mostly literal still comes through.
    """

    def __init__(self, text: str):
        self.toks = [(m.lastgroup, m.group()) for m in JS_TOKEN.finditer(text)
                     if m.lastgroup != "ws"]
        self.i = 0
        self._calling: set[str] = set()

    def _returned(self, name: str):
        """What `function name() { return <literal> }` in the same file returns."""
        if name in self._calling:
            return None
        for j in range(len(self.toks) - 1):
            if self.toks[j] == ("name", "function") and self.toks[j + 1][1] == name:
                for r in range(j + 2, len(self.toks)):
                    if self.toks[r] == ("name", "return"):
                        saved, self.i = self.i, r + 1
                        self._calling.add(name)
                        try:
                            return self.value()
                        finally:
                            self._calling.discard(name)
                            self.i = saved
                return None
        return None

    def _peek(self, ahead: int = 0) -> tuple[str, str]:
        j = self.i + ahead
        return self.toks[j] if j < len(self.toks) else ("", "")

    @staticmethod
    def _unquote(tok: str) -> str:
        return re.sub(r"\\(.)", lambda m: {"n": "\n", "t": "\t"}.get(m.group(1), m.group(1)),
                      tok[1:-1])

    def _skip(self) -> None:
        """Past one expression, stopping before the `,` or bracket that ends it."""
        depth = 0
        while self.i < len(self.toks):
            kind, v = self.toks[self.i]
            if kind == "punct" and v in "([{":
                depth += 1
            elif kind == "punct" and v in ")]}":
                if depth == 0:
                    return
                depth -= 1
            elif kind == "punct" and v == "," and depth == 0:
                return
            self.i += 1

    def value(self):
        kind, v = self._peek()
        if v == "{" and kind == "punct":
            return self._object()
        if v == "[" and kind == "punct":
            return self._array()
        if kind == "str":
            self.i += 1
            return self._unquote(v)
        if kind == "num" and self._peek(1)[1] in (",", "}", "]", ""):
            self.i += 1
            return float(v) if "." in v else int(v)
        if kind == "name" and v in ("true", "false", "null", "undefined") \
                and self._peek(1)[1] in (",", "}", "]", ""):
            self.i += 1
            return {"true": True, "false": False}.get(v)
        if kind == "name" and self._peek(1)[1] == "(":   # a helper such as sidebarGuide()
            result = self._returned(v)
            if result is not None:
                self._skip()
                return result
        self._skip()
        return None

    def _object(self) -> dict:
        self.i += 1
        out: dict = {}
        while self.i < len(self.toks):
            kind, v = self._peek()
            if kind == "punct" and v == "}":
                self.i += 1
                return out
            if kind == "punct" and v == ",":
                self.i += 1
            elif kind == "spread":
                self.i += 1
                self._skip()
            elif kind in ("str", "name", "num"):
                key = self._unquote(v) if kind == "str" else v
                self.i += 1
                if self._peek()[1] == ":":
                    self.i += 1
                    out[key] = self.value()
                elif self._peek()[1] in (",", "}"):
                    out[key] = None   # shorthand property: a variable
                else:
                    self._skip()      # method, getter, anything else
            else:
                self._skip()
                if self._peek()[1] not in (",", "}"):
                    self.i += 1
        return out

    def _array(self) -> list:
        self.i += 1
        out: list = []
        while self.i < len(self.toks):
            kind, v = self._peek()
            if kind == "punct" and v == "]":
                self.i += 1
                return out
            if kind == "punct" and v == ",":
                self.i += 1
            elif kind == "spread":
                self.i += 1
                self._skip()
            else:
                start = self.i
                out.append(self.value())
                if self.i == start:
                    self.i += 1
        return out

    def lookup(self, name: str):
        """The first literal given to `name`, as a key (`name: ...`) or a binding
        (`name = ...`, `name: Type = ...`)."""
        for j, (kind, v) in enumerate(self.toks):
            if v != name or kind not in ("name", "str"):
                continue
            after = [t[1] for t in self.toks[j + 1:j + 4]] + ["", "", ""]
            if after[0] == ":" and self.toks[j + 2][0] == "name" and after[2] == "=":
                self.i = j + 4                         # TypeScript annotation
            elif after[0] == ":" or (after[0] == "=" and after[1] not in ("=", ">")):
                self.i = j + 2
            else:
                continue
            found = self.value()
            if found is not None:
                return found
        return None

    def assigned_object(self, want) -> "dict | None":
        """The first `= {...}` or `export default {...}` object that satisfies `want`."""
        for j, (kind, v) in enumerate(self.toks):
            if kind != "punct" or v != "{" or j == 0:
                continue
            prev, prev2 = self.toks[j - 1][1], self.toks[j - 2][1] if j > 1 else ""
            if prev == "=" or (prev == "default" and prev2 == "export"):
                self.i = j
                found = self._object()
                if want(found):
                    return found
        return None


def _docusaurus_items(entries, prefix: str) -> list[NavItem]:
    items: list[NavItem] = []
    for e in entries or []:
        if isinstance(e, str):
            items.append(NavItem(target=prefix + e))
        elif isinstance(e, dict):
            kind = e.get("type")
            if kind in ("doc", "ref") and e.get("id"):
                items.append(NavItem(title=str(e.get("label") or ""), target=prefix + str(e["id"])))
            elif kind == "category" or (kind is None and isinstance(e.get("items"), list)):
                link = e.get("link") if isinstance(e.get("link"), dict) else {}
                target = prefix + str(link["id"]) if link.get("type") == "doc" and link.get("id") else ""
                items.append(NavItem(title=str(e.get("label") or ""), target=target,
                                     children=_docusaurus_items(e.get("items"), prefix)))
            elif kind == "autogenerated":
                items.append(NavItem(expand=prefix + str(e.get("dirName") or "").strip("./")))
            elif kind is None:   # shorthand category: {"Label": [items]}
                for label, value in e.items():
                    if isinstance(value, list):
                        items.append(NavItem(title=str(label),
                                             children=_docusaurus_items(value, prefix)))
    return items


def nav_docusaurus(root: Path, index: PageIndex):
    """Docusaurus: sidebars.ts/js/json beside the site's docusaurus.config."""
    import json as jsonlib

    def is_site(d: Path) -> bool:
        return any((d / f"docusaurus.config.{e}").is_file() for e in ("ts", "js", "mjs", "cjs"))

    for folder, prefix in ((root.parent, ""), (root, "docs/")):
        if not (is_site(folder) or (prefix == "" and root.name == "docs")):
            continue
        for name in ("sidebars.ts", "sidebars.js", "sidebars.mjs", "sidebars.cjs", "sidebars.json"):
            f = folder / name
            if not f.is_file():
                continue
            text = f.read_text(encoding="utf-8", errors="replace")
            data = jsonlib.loads(text) if name.endswith(".json") else JSLiteral(text).assigned_object(
                lambda o: isinstance(o, dict) and any(isinstance(v, (list, dict)) for v in o.values()))
            if not isinstance(data, dict):
                return None
            items: list[NavItem] = []
            for value in data.values():   # every sidebar, in file order
                items += _docusaurus_items(value if isinstance(value, list) else [value], prefix)
            return (items, name) if items else None
    return None


def _locale_dirs(root: Path, prefix: str, locales) -> list[str]:
    """Folders holding translations, which would repeat every page in another language."""
    if not isinstance(locales, dict):
        return []
    return [prefix + k + "/" for k in locales if k != "root" and (root / prefix / k).is_dir()]


def _starlight_items(entries, prefix: str) -> list[NavItem]:
    items: list[NavItem] = []
    for e in entries or []:
        if isinstance(e, str):
            items.append(NavItem(target=prefix + e))
        elif isinstance(e, dict):
            label = str(e.get("label") or "")
            if isinstance(e.get("autogenerate"), dict):
                directory = str(e["autogenerate"].get("directory") or "").strip("/")
                items.append(NavItem(title=label, expand=prefix + directory))
            elif isinstance(e.get("items"), list):
                items.append(NavItem(title=label, children=_starlight_items(e["items"], prefix)))
            elif isinstance(e.get("slug") or e.get("link"), str):
                target = e.get("slug") or e.get("link")
                if not URL_SCHEME.match(target):
                    items.append(NavItem(title=label, target=prefix + target.strip("/")))
    return items


def nav_starlight(root: Path, index: PageIndex):
    """Astro Starlight: the sidebar in astro.config, for pages in src/content/docs."""
    if [p.lower() for p in root.parts[-3:]] == ["src", "content", "docs"]:
        site, prefix = root.parents[2], ""
    elif (root / "src" / "content" / "docs").is_dir():
        site, prefix = root, "src/content/docs/"
    else:
        return None
    cfg = next((site / f"astro.config.{e}" for e in ("mjs", "ts", "js", "mts")
                if (site / f"astro.config.{e}").is_file()), None)
    if cfg is None:
        return None
    parser = JSLiteral(cfg.read_text(encoding="utf-8", errors="replace"))
    sidebar = parser.lookup("sidebar")
    if not isinstance(sidebar, list):
        return None
    drop = _locale_dirs(root, prefix, parser.lookup("locales"))
    return _starlight_items(sidebar, prefix), f"{cfg.name} sidebar", drop


def nav_mkdocs(root: Path, index: PageIndex):
    """MkDocs: the `nav` in mkdocs.yml, whose paths are relative to docs_dir."""
    for folder in (root, root.parent):
        for name in ("mkdocs.yml", "mkdocs.yaml"):
            cfg = folder / name
            if not cfg.is_file():
                continue
            data = load_yaml(cfg.read_text(encoding="utf-8", errors="replace"))
            if not isinstance(data, dict):
                return None
            docs = (folder / str(data.get("docs_dir") or "docs")).resolve()
            if docs == root:
                prefix = ""
            elif root in docs.parents:
                prefix = docs.relative_to(root).as_posix() + "/"
            else:
                continue
            if not isinstance(data.get("nav"), list):
                return None   # without a nav, MkDocs itself orders by folder
            return _mkdocs_items(data["nav"], prefix), f"{name} nav"
    return None


def _mkdocs_items(entries: list, prefix: str) -> list[NavItem]:
    items = []
    for e in entries:
        if isinstance(e, str):
            items.append(NavItem(target=prefix + e))
        elif isinstance(e, dict):
            for title, value in e.items():
                if isinstance(value, str) and not URL_SCHEME.match(value):
                    items.append(NavItem(title=str(title), target=prefix + value))
                elif isinstance(value, list):
                    items.append(NavItem(title=str(title), children=_mkdocs_items(value, prefix)))
    return items


SUMMARY_LINK = re.compile(r"^(\s*)(?:[-*+]\s+)?\[(.*?)\]\((.*?)\)\s*$")


def nav_summary(root: Path, index: PageIndex):
    """mdBook and GitBook: SUMMARY.md, a nested list of links under part headings."""
    f = root / "SUMMARY.md"
    if not f.is_file():
        return None
    items: list[NavItem] = []
    part = items
    stack: list[tuple[int, NavItem]] = []
    linked = False
    for line in f.read_text(encoding="utf-8", errors="replace").splitlines():
        h = re.match(r"^#{1,6}\s+(.*)", line)
        if h:
            label = h.group(1).strip()
            if not items and label.lower() in ("summary", "table of contents", "contents"):
                continue   # the file's own title
            sec = NavItem(title=label)
            items.append(sec)
            part, stack = sec.children, []
            continue
        m = SUMMARY_LINK.match(line)
        if not m or not m.group(3).strip():   # not a link, or an mdBook draft chapter
            continue
        linked = True
        indent = len(m.group(1).expandtabs(4))
        item = NavItem(title=m.group(2).strip(), target=m.group(3).strip())
        while stack and stack[-1][0] >= indent:
            stack.pop()
        (stack[-1][1].children if stack else part).append(item)
        stack.append((indent, item))
    return (items, "SUMMARY.md") if linked else None


def _parse_toctrees(text: str, markdown: bool) -> list[tuple[str, list[tuple[str, str]], bool, str]]:
    """Each toctree in a Sphinx document: (caption, [(title, docname)], glob, heading above)."""
    lines = text.splitlines()
    blocks = []
    heading = ""
    i = 0
    while i < len(lines):
        line = lines[i]
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if markdown:
            h = re.match(r"^#{1,6}\s+(.*)", line)
            if h:
                heading = h.group(1).strip()
            opener = re.match(r"^(`{3,}|:{3,})\{toctree\}", line.strip())
        else:
            s = line.strip()
            if (s and not line[:1].isspace() and not RST_ADORNMENT.fullmatch(s)
                    and RST_ADORNMENT.fullmatch(nxt.rstrip()) and len(nxt.rstrip()) >= len(s)):
                heading = s
            opener = re.match(r"^\s*\.\.\s+toctree::", line)
        i += 1
        if not opener:
            continue
        fence = opener.group(1) if markdown else ""
        caption, glob, entries = "", False, []
        while i < len(lines):
            raw, s = lines[i], lines[i].strip()
            if markdown and s.startswith(fence) and not s.lstrip(fence[0]):
                i += 1
                break
            if not markdown and s and not raw[:1].isspace():
                break
            i += 1
            if not s or s == "---":
                continue
            opt = re.match(r"^:?(\w+):\s*(.*)$", s) if s.startswith(":") or (markdown and re.match(r"^\w+:\s", s)) else None
            if opt:
                if opt.group(1) == "caption":
                    caption = opt.group(2).strip()
                elif opt.group(1) == "glob":
                    glob = True
                continue
            em = re.match(r"^(.*?)\s*<([^>]+)>$", s)
            entries.append((em.group(1).strip(), em.group(2).strip()) if em else ("", s))
        blocks.append((caption, entries, glob, heading))
    return blocks


def _toctree_items(page: Page, index: PageIndex, prefix: str, seen: set, top: bool) -> list[NavItem]:
    import fnmatch

    text = page.src.read_text(encoding="utf-8", errors="replace")
    docdir = posixpath.dirname(page.rel.as_posix())
    out: list[NavItem] = []
    for caption, entries, glob, heading in _parse_toctrees(text, page.kind == "md"):
        group: list[NavItem] = []
        for title, name in entries:
            if name == "self" or URL_SCHEME.match(name):
                continue
            target = (prefix + name.lstrip("/")) if name.startswith("/") \
                else posixpath.normpath(posixpath.join(docdir, name))
            if glob and any(c in name for c in "*?["):
                found = sorted((p for p in index.pages
                                if fnmatch.fnmatch(posixpath.splitext(p.rel.as_posix())[0], target)),
                               key=lambda p: natural(p.rel.as_posix()))
            else:
                found = [index.find(target)]
            for child in found:
                if child is None or id(child) in seen:
                    continue
                seen.add(id(child))
                group.append(NavItem(title=title, target=child.rel.as_posix(),
                                     children=_toctree_items(child, index, prefix, seen, False)))
        # the root document's toctrees group the sidebar; untitled ones borrow the heading above
        label = caption or (heading if top else "")
        if label and group:
            out.append(NavItem(title=label, children=group))
        else:
            out.extend(group)
    return out


def nav_sphinx(root: Path, index: PageIndex):
    """Sphinx: the toctree hierarchy, starting from root_doc in conf.py."""
    for base in ("", "source/"):
        conf = root / base / "conf.py"
        if conf.is_file():
            break
    else:
        return None
    m = re.search(r"^(?:root_doc|master_doc)\s*=\s*['\"]([^'\"]+)['\"]",
                  conf.read_text(encoding="utf-8", errors="replace"), re.M)
    start = index.find(base + (m.group(1) if m else "index"))
    if start is None:
        return None
    seen = {id(start)}
    items = [NavItem(target=start.rel.as_posix())] + _toctree_items(start, index, base, seen, True)
    return (items, "Sphinx toctree") if len(items) > 1 else None


def nav_jekyll(root: Path, index: PageIndex):
    """Jekyll: a navigation data file (_data/docs_nav.yml and friends) listing permalinks."""
    site = next((d for d in (root, root.parent) if (d / "_config.yml").is_file()), None)
    if site is None:
        return None
    for name in ("docs_nav.yml", "navigation.yml", "nav.yml", "sidebar.yml", "toc.yml"):
        f = site / "_data" / name
        if f.is_file():
            items = _data_nav_items(load_yaml(f.read_text(encoding="utf-8", errors="replace")))
            return (items, f"_data/{name}") if items else None
    return None


def _data_nav_items(data) -> list[NavItem]:
    items: list[NavItem] = []
    if not isinstance(data, list):
        return items
    for e in data:
        if isinstance(e, str):
            items.append(NavItem(target=e))
        elif isinstance(e, dict):
            kids = next((v for k, v in e.items() if isinstance(v, list) and k in
                         ("docs", "children", "items", "links", "pages", "subfolderitems")), None)
            items.append(NavItem(
                title=str(e.get("title") or e.get("text") or e.get("label") or ""),
                target=str(e.get("link") or e.get("url") or e.get("page") or e.get("path") or ""),
                children=_data_nav_items(kids) if kids else []))
    return items


def _vitepress_items(entries, base: str) -> list[NavItem]:
    items: list[NavItem] = []
    for e in entries or []:
        if not isinstance(e, dict):
            continue
        here = e["base"] if isinstance(e.get("base"), str) else base
        link = e.get("link")
        target = ""
        if isinstance(link, str) and not URL_SCHEME.match(link):
            target = link if link.startswith("/") else here + link
        items.append(NavItem(title=str(e.get("text") or ""), target=target,
                             children=_vitepress_items(e.get("items"), here)))
    return items


def nav_vitepress(root: Path, index: PageIndex):
    """VitePress: themeConfig.sidebar, as one list or per-path groups, honouring
    `base` prefixes, `rewrites` (such as en/ served at /) and locale folders."""
    configs = [root / ".vitepress" / f"config.{e}" for e in ("ts", "mts", "js", "mjs")]
    main_cfg = next((c for c in configs if c.is_file()), None)
    if main_cfg is None:
        return None
    main = JSLiteral(main_cfg.read_text(encoding="utf-8", errors="replace"))
    candidates = [main_cfg] + [root / ".vitepress" / "config" / f"{n}.{e}"
                               for n in ("index", "en", "shared") for e in ("ts", "mts", "js", "mjs")] \
        + [root / f"config.{e}" for e in ("ts", "mts", "js", "mjs")] \
        + [root / "en" / f"config.{e}" for e in ("ts", "mts", "js", "mjs")]
    sidebar, used = None, main_cfg
    for c in candidates:
        if c.is_file():
            found = (main if c == main_cfg else
                     JSLiteral(c.read_text(encoding="utf-8", errors="replace"))).lookup("sidebar")
            if isinstance(found, (list, dict)):
                sidebar, used = found, c
                break
    if sidebar is None:
        return None
    groups = [sidebar] if isinstance(sidebar, list) else list(sidebar.values())
    items: list[NavItem] = []
    for g in groups:
        if isinstance(g, list):
            items += _vitepress_items(g, "/")
        elif isinstance(g, dict):
            items += _vitepress_items(g.get("items"), g["base"] if isinstance(g.get("base"), str) else "/")

    # rewrites map source paths to URLs ('en/:rest*': ':rest*'); links name URLs
    rewrites = main.lookup("rewrites")
    pairs = [(k.split(":", 1)[0], v.split(":", 1)[0]) for k, v in (rewrites or {}).items()
             if isinstance(v, str) and ":" in k and ":" in v]

    def retarget(entries: list[NavItem]) -> None:
        for it in entries:
            url = it.target.lstrip("/")
            if url and index.find(url) is None:
                for source, served in pairs:
                    if url.startswith(served) and index.find(source + url[len(served):]):
                        it.target = source + url[len(served):]
                        break
            retarget(it.children)

    retarget(items)
    rel = used.relative_to(root).as_posix()
    return items, f"{rel} sidebar", _locale_dirs(root, "", main.lookup("locales"))


NAV_SOURCES = [nav_mkdocs, nav_summary, nav_sphinx, nav_jekyll, nav_docusaurus, nav_starlight,
               nav_vitepress]


def arrange(pages: list[Page], root: Path) -> str:
    """Put pages in reading order and sections. Returns where the order came from."""
    arrange_by_folders(pages, root)
    index = PageIndex(pages)
    for source in NAV_SOURCES:
        try:
            found = source(root, index)
        except Exception as exc:   # a config bookify can't read falls back to folders
            print(f"bookify: ignoring navigation from {source.__name__[4:]}: {exc}",
                  file=sys.stderr)
            continue
        if not found:
            continue
        items, label, *extra = found
        drop = tuple(extra[0]) if extra and extra[0] else ()
        if drop:   # translations of the same pages
            pages[:] = [p for p in pages if not p.rel.as_posix().startswith(drop)]
            index = PageIndex(pages)
        placed = apply_outline(pages, items, index)
        if placed:
            if label == "SUMMARY.md":   # it's the table of contents, not a chapter
                pages[:] = [p for p in pages if p.rel.as_posix().lower() != "summary.md"]
            return f"{label} ({placed} of {len(pages)} pages listed)"
    return "folders"


