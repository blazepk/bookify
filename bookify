def _dig(data, keys: list[str]):
    for k in keys:
        if not isinstance(data, dict):
            return None
        data = data.get(k)
    return data


def _yaml_file(path: Path) -> dict:
    try:
        data = load_yaml(path.read_text(encoding="utf-8", errors="replace"))
    except Exception:   # an unreadable config just means no variables
        return {}
    return data if isinstance(data, dict) else {}
MDX_LABEL = {"TabItem", "Tab", "Card"}


def _sc_args(s: str) -> tuple[list[str], dict[str, str]]:
    """Positional and key="value" arguments of a shortcode."""
    import shlex

    s = s.strip()
    s = s[:-1].strip() if s.endswith("/") else s
    try:
        tokens = shlex.split(s)
    except ValueError:
        tokens = s.split()
    pos, kw = [], {}
    for t in tokens:
        k, eq, v = t.partition("=")
        if eq and re.fullmatch(r"[\w-]+", k):
            kw[k.lower()] = v
        else:
            pos.append(t)
    return pos, kw


def _jsx_attrs(s: "str | None") -> dict[str, str]:
    return {m.group(1).lower(): next((g for g in m.group(2, 3, 4) if g is not None), "true")
            for m in MDX_ATTR.finditer(s or "")}


class Templates:
    """Rewrites docs-generator markup into Markdown and HTML the renderer knows."""

    MAX_INSERTS = 100

    def __init__(self, root: Path, index: PageIndex):
        self.root = root
        self.index = index
        self.include_dirs: list[Path] = []
        self.snippet_dirs: list[Path] = []
        self.liquid = ""            # "jekyll" or "jinja" when the site's pages are templates
        self.site: dict = {}        # site.* (Jekyll _config.yml) or config.* (mkdocs.yml)
        self.variables: dict = {}   # names mkdocs-macros exposes directly: the `extra` block
        self._raw = self._comment = False

        jekyll = next((d for d in (root, root.parent) if (d / "_config.yml").is_file()), None)
        if jekyll:
            self.liquid = "jekyll"
            self.site = _yaml_file(jekyll / "_config.yml")
            self.include_dirs.append(jekyll / "_includes")
        cfg_path = next((d / n for d in (root, root.parent) for n in ("mkdocs.yml", "mkdocs.yaml")
                         if (d / n).is_file()), None)
        if cfg_path:
            cfg = _yaml_file(cfg_path)
            for plugin in cfg.get("plugins") or []:
                name, opts = (plugin, {}) if isinstance(plugin, str) else next(iter(plugin.items()), ("", {}))
                if name == "macros":
                    self.liquid = self.liquid or "jinja"
                    self.site = cfg
                    self.variables = cfg.get("extra") if isinstance(cfg.get("extra"), dict) else {}
                    if isinstance(opts, dict) and opts.get("include_dir"):
                        self.include_dirs.append(cfg_path.parent / str(opts["include_dir"]))
            for ext in cfg.get("markdown_extensions") or []:
                name, opts = (ext, {}) if isinstance(ext, str) else next(iter(ext.items()), ("", {}))
                if name == "pymdownx.snippets":
                    paths = (opts or {}).get("base_path", ".") if isinstance(opts, dict) else "."
                    for p in (paths if isinstance(paths, list) else [paths]):
                        self.snippet_dirs.append(cfg_path.parent / str(p))

    def _read(self, candidates: list[Path], allowed: list[Path]) -> "list[str] | None":
        roots = []
        for a in allowed:
            try:
                roots.append(a.resolve())
            except OSError:
                continue
        for c in candidates:
            try:
                path = c.resolve()
                if path.is_file() and any(path == r or r in path.parents for r in roots):
                    _, body = split_front_matter(path.read_text(encoding="utf-8", errors="replace"))
                    return body.split("\n")
            except OSError:
                continue
        return None

    def url(self, value: str, base: str) -> str:
        """A site URL (/docs/x/, or docs/x/ given to relative_url) as a link relative
        to the page when the book has that page or file; otherwise as given."""
        if URL_SCHEME.match(value) or value.startswith(("#", "//")):
            return value
        path, _, anchor = value.partition("#")
        page = self.index.find("/" + path.lstrip("/"))
        if page is not None:
            return posixpath.relpath(page.rel.as_posix(), base or ".") + ("#" + anchor if anchor else "")
        if path.strip("/") and (self.root / path.lstrip("/")).is_file():
            return posixpath.relpath(path.lstrip("/"), base or ".")
        return value

    def _expr(self, expr: str, base: str, meta: dict) -> str:
        head, *filters = [p.strip() for p in expr.split("|")]
        literal = re.fullmatch(r"""(['"])(.*)\1""", head)
        if literal:
            value = literal.group(2)
        else:
            parts = head.split(".")
            if parts[0] == "page":
                rest = parts[1:2] if parts[1:2] != ["meta"] else parts[2:3]
                value = meta.get(rest[0].lower()) if rest else None
            elif parts[0] in ("site", "config"):
                value = _dig(self.site, parts[1:])
            else:
                value = _dig(self.variables, parts)
        if value is None or isinstance(value, (dict, list)):
            return ""
        value = str(value)
        for f in filters:
            name, _, arg = f.partition(":")
            name, arg = name.strip(), arg.strip()
            if name in ("relative_url", "absolute_url", "url"):
                value = self.url(value, base)
            elif name in ("prepend", "append"):
                lit = re.fullmatch(r"""(['"])(.*)\1""", arg)
                extra = lit.group(2) if lit else ""   # site.baseurl and friends have no meaning here
                value = extra + value if name == "prepend" else value + extra
            elif name in ("upcase", "upper"):
                value = value.upper()
            elif name in ("downcase", "lower"):
                value = value.lower()
        return html_mod.escape(value, quote=False)

    def _liquid(self, line: str, base: str, meta: dict) -> "str | None":
        """Liquid/Jinja on one line, carrying raw and comment blocks across lines.
        None means the whole line sat inside a comment."""
        out: list[str] = []
        pos = 0
        for m in LIQUID_TOKEN.finditer(line):
            text, pos = line[pos:m.start()], m.end()
            tag = (m.group(1) or "").lower()
            if self._raw:
                out.append(text + ("" if tag == "endraw" else m.group(0)))
                self._raw = tag != "endraw"
                continue
            if self._comment:
                self._comment = tag != "endcomment"
                continue
            out.append(text)
            if tag == "raw":
                self._raw = True
            elif tag == "comment":
                self._comment = True
            elif tag in ("link", "post_url"):
                target = m.group(2).strip().strip("'\"")
                if tag == "post_url":
                    hits = self.index.by_stem.get(target.lower(), [])
                    out.append(posixpath.relpath(hits[0].rel.as_posix(), base or ".") if hits else target)
                else:
                    out.append(self.link_to(target, base))
            elif not tag:
                out.append(self._expr(m.group(3), base, meta))
            # control flow, assignments and captures render nothing by themselves
        if self._comment:
            return "".join(out) if out and "".join(out).strip() else None
        out.append(line[pos:])
        return "".join(out)

    def _liquid_include(self, kind: str, name: str, base: str) -> "list[str] | None":
        if kind == "include_relative":
            got = self._read([self.root / base / name], [self.root])
        else:
            got = self._read([d / name for d in self.include_dirs] + [self.root / name],
                             [*self.include_dirs, self.root])
        if got is not None and Path(name).suffix.lower() in HTML_EXTS and any("{%" in x for x in got):
            return []   # a fragment that loops over site data renders nothing without Jekyll
        return got

    def link_to(self, target: str, base: str) -> str:
        """A page reference as a link relative to the page at `base`, or as given."""
        name, _, anchor = target.strip().partition("#")
        page = self.index.find(name, base) if name else None
        if page is None and name:
            key = Path(name.rstrip("/")).name.lower()
            key = key[:-3] if key.endswith(".md") else key
            hits = self.index.by_stem.get(key, [])
            page = hits[0] if hits else None
        if page is None:
            return target
        return posixpath.relpath(page.rel.as_posix(), base or ".") + ("#" + anchor if anchor else "")

    def read_include(self, name: str, base: str) -> "list[str] | None":
        """The lines of a shared file, only from inside the book or its include folders."""
        name = name.strip().strip("\"'")
        if not name:
            return None
        candidates = [self.root / name.lstrip("/"), self.root / base / name,
                      *(d / name.lstrip("/") for d in self.include_dirs)]
        return self._read(candidates, [self.root, *self.include_dirs])

    @staticmethod
    def _open_shortcode(name: str, pos: list[str], kw: dict[str, str]):
        esc = html_mod.escape
        if name in CALLOUT_SC:
            kind = kw.get("type") or kw.get("kind") or (
                pos[0] if pos and name in GENERIC_CALLOUT_SC else name)
            kind = kind if re.fullmatch(r"[\w-]+", kind or "") else "note"
            title = kw.get("title") or (pos[1] if name in GENERIC_CALLOUT_SC and len(pos) > 1 else "")
            return _callout(kind, esc(title)), ["", "</div>", ""]
        if name in DETAILS_SC:
            summary = kw.get("title") or kw.get("summary") or (pos[0] if pos else "Details")
            return (["", '<details markdown="1">', f"<summary>{esc(summary)}</summary>", ""],
                    ["", "</details>", ""])
        if name in TABSET_SC:
            return [], []
        if name in TAB_SC:
            label = kw.get("name") or kw.get("title") or kw.get("header") or kw.get("label") \
                or (pos[0] if pos else "")
            return (["", f'<p class="tab-label">{esc(label)}</p>', ""] if label else []), []
        if name in ("figure", "img", "image"):
            src = kw.get("src") or (pos[0] if pos else "")
            if not src:
                return [], []
            caption = kw.get("caption") or kw.get("title") or ""
            fig = ["", '<figure markdown="1">', "", f"![{_md_text(kw.get('alt') or caption)}](<{src}>)", ""]
            if caption:
                fig.append(f"<figcaption>{esc(caption)}</figcaption>")
            return fig + ["</figure>", ""], []
        return None

    def _inline_shortcode(self, m: re.Match, base: str, meta: dict) -> str:
        if m.group(2):   # a closing tag that no block was waiting for
            return ""
        name = m.group(3).lower()
        pos, kw = _sc_args(m.group(4))
        first = pos[0] if pos else ""
        if name in ("ref", "relref"):
            return self.link_to(first or kw.get("path", ""), base)
        if name == "param":
            return html_mod.escape(str(meta.get((first or kw.get("name", "")).lower(), "")))
        if name in ("new-in", "deprecated-in") and first:
            word = "New in" if name == "new-in" else "Deprecated in"
            return f'<span class="badge">{word} {html_mod.escape(first)}</span>'
        if name == "youtube" and (kw.get("id") or first):
            return f"[▶ YouTube video](https://www.youtube.com/watch?v={kw.get('id') or first})"
        if name == "vimeo" and (kw.get("id") or first):
            return f"[▶ Vimeo video](https://vimeo.com/{kw.get('id') or first})"
        if name in ("figure", "img", "image") and (kw.get("src") or first):
            return f"![{_md_text(kw.get('alt', ''))}](<{kw.get('src') or first}>)"
        if name == "glossary-term" and first:
            return f"**{first}**"
        return ""   # shortcodes only the site's own templates know how to render

    @staticmethod
    def _inline_components(line: str) -> str:
        """Self-closing components inside a line of prose: a Badge keeps its text,
        anything else (a live demo, a computed URL) has nothing to show on paper."""
        spans = [m.span() for m in re.finditer(r"`+[^`]*`+", line)]

        def one(m: re.Match) -> str:
            if any(a <= m.start() < b for a, b in spans):
                return m.group(0)
            attrs = _jsx_attrs(m.group(2))
            if m.group(1).split(".")[-1] == "Badge" and attrs.get("text"):
                return f'<span class="badge">{html_mod.escape(attrs["text"])}</span>'
            return ""

        return MDX_INLINE.sub(one, line)

    def _component(self, tag: str, stack: list, out: list[str]) -> bool:
        close = MDX_CLOSE.match(tag)
        if close:
            for n in range(len(stack) - 1, -1, -1):
                if stack[n][0] == close.group(1):
                    out += stack.pop(n)[1]
                    break
            return True
        m = MDX_OPEN.match(tag)
        if not m:
            head = re.match(r"^\s*<([A-Z][\w.]*)", tag)
            if not head or not re.search(r">\s*$", tag):
                return False
            # props too rich to read (arrow functions, nested JSX): a live demo has
            # nothing to show on paper, and a wrapper keeps only its children
            if not tag.rstrip().endswith("/>"):
                stack.append((head.group(1), []))
            return True
        name, attrs, self_closing = m.group(1), _jsx_attrs(m.group(2)), bool(m.group(3))
        short = name.split(".")[-1]
        esc = html_mod.escape
        start: list[str] = []
        end: list[str] = []
        if short in MDX_CALLOUT:
            kind = attrs.get("type") or (short.lower() if short not in ("Admonition", "Aside", "Callout")
                                         else "note")
            start, end = _callout(kind, esc(attrs.get("title", ""))), ["", "</div>", ""]
        elif short in MDX_LABEL:
            label = attrs.get("label") or attrs.get("title") or attrs.get("value") or ""
            start = ["", f'<p class="tab-label">{esc(label)}</p>', ""] if label else []
        elif short == "LinkCard" and attrs.get("href"):
            text = attrs.get("title") or attrs["href"]
            more = f" — {attrs['description']}" if attrs.get("description") else ""
            start = ["", f"[{_md_text(text)}]({attrs['href']}){more}", ""]
        elif short == "Badge" and attrs.get("text"):
            start = [f'<span class="badge">{esc(attrs["text"])}</span>']
        out += start
        if not self_closing:
            stack.append((name, end))
        return True

    def expand(self, text: str, page: "Page | None", meta: dict) -> str:
        mdx = bool(page) and page.src.suffix.lower() == ".mdx"
        if not mdx and "{{" not in text and "{%" not in text and "8<-" not in text:
            return text
        self._raw = self._comment = False
        base = posixpath.dirname(page.rel.as_posix()) if page else ""
        lines = text.split("\n")
        out: list[str] = []
        stack: list[tuple[str, list[str]]] = []   # open blocks and the lines that close them
        fence = ""
        raw_close: "re.Pattern | None" = None     # inside a code shortcode
        raw_indent = ""
        in_comment = False
        inserts = 0
        i = 0
        while i < len(lines):
            line = SHORTCODE_ESCAPED.sub(
                lambda m: f"{LITERAL_BRACES}{m.group(1)} {m.group(2)} {m.group(3)}}}}}", lines[i])
            i += 1
            if mdx and any(n[:1].isupper() for n, _ in stack):
                # component children are often indented with tabs, which Markdown reads as code
                depth = sum(1 for n, _ in stack if n[:1].isupper())
                line = re.sub(r"^\t{1,%d}" % depth, "", line)
            if raw_close is not None:
                if raw_close.search(line):
                    out.append(raw_indent + "```")
                    raw_close = None
                else:
                    out.append(line)
                continue
            if self.snippet_dirs and "8<-" in line:
                # pymdownx.snippets runs before Markdown, code blocks included
                one = SNIPPET_LINE.match(line)
                if one and one.group(2):   # ;--8<-- shows the marker itself
                    line = one.group(1) + line.lstrip()[1:]
                elif (one or SNIPPET_BLOCK.match(line)) and inserts < self.MAX_INSERTS:
                    names = [one.group(4)] if one else []
                    if not one:
                        while i < len(lines) and not SNIPPET_BLOCK.match(lines[i]):
                            entry = lines[i].strip()
                            if entry and not entry.startswith(";"):
                                names.append(entry)
                            i += 1
                        i += 1
                    inserted: list[str] = []
                    for name in names:
                        plain = name.split(":", 1)[0] if ":" in name and not (self.root / name).exists() else name
                        got = self._read([d / plain for d in self.snippet_dirs] + [self.root / plain],
                                         [*self.snippet_dirs, self.root])
                        inserted += got or []
                    inserts += 1
                    lines[i:i] = inserted
                    continue
            if self.liquid:
                if not (self._raw or self._comment):
                    hl = LIQUID_HIGHLIGHT.match(line)
                    if hl:
                        out.append(hl.group(1) + "```" + hl.group(2))
                        fence = "```"
                        continue
                    if LIQUID_ENDHIGHLIGHT.match(line):
                        out.append(line[: len(line) - len(line.lstrip())] + "```")
                        fence = ""
                        continue
                    inc = LIQUID_INCLUDE.match(line)
                    if inc and inserts < self.MAX_INSERTS:
                        got = self._liquid_include(inc.group(1), inc.group(3), base)
                        if got is not None:
                            inserts += 1
                            lines[i:i] = got
                            continue
                # Jekyll and mkdocs-macros render templates inside code blocks too
                line = self._liquid(line, base, meta)
                if line is None:
                    continue
            if fence:
                out.append(line)
                s = line.strip()
                if s.startswith(fence) and not s.lstrip(fence[0]):
                    fence = ""
                continue
            if mdx:
                if in_comment:
                    if "*/}" not in line:
                        continue
                    line, in_comment = line.split("*/}", 1)[1], False
                line = MDX_COMMENT.sub("", line)
                if "{/*" in line:
                    line, in_comment = line.split("{/*", 1)[0], True
            m = FENCE.match(line)
            if m:
                fence = m.group(1)
                out.append(line)
                continue
            tail = line.rsplit("{{", 1)[-1] if ("{{<" in line or "{{%" in line) else ""
            if tail[:1] in ("<", "%") and not re.search(r"[>%]\}\}", tail):
                # a shortcode whose arguments run over several lines
                j, joined = i, line
                while j < len(lines) and j - i < 30:
                    joined += " " + lines[j].strip()
                    j += 1
                    if re.search(r"[>%]\}\}", lines[j - 1]):
                        line, i = joined, j
                        break
            s = line.strip()
            sc = SHORTCODE.fullmatch(s) if s.startswith("{{") else None
            if sc:
                name = sc.group(3).lower()
                pos, kw = _sc_args(sc.group(4))
                if sc.group(2):
                    for n in range(len(stack) - 1, -1, -1):
                        if stack[n][0] == name:
                            out += stack.pop(n)[1]
                            break
                    continue
                if name in CODE_SC:
                    if sc.group(4).strip().endswith("/"):
                        continue   # renders the site's own config, which the book doesn't have
                    lang = kw.get("lang") or kw.get("language") or \
                        (pos[0] if pos and name == "highlight" else "") or \
                        ("toml" if name == "code-toggle" else "")
                    raw_indent = line[: len(line) - len(line.lstrip())]   # stay inside a list item
                    out.append(raw_indent + "```" + lang)
                    raw_close = re.compile(r"\{\{[<%]\s*/\s*" + re.escape(name) + r"\s*[>%]\}\}")
                    continue
                if name in ("include", "readfile") and inserts < self.MAX_INSERTS:
                    included = self.read_include(pos[0] if pos else kw.get("file", ""), base)
                    if included is not None:
                        inserts += 1
                        lines[i:i] = included
                        continue
                opened = self._open_shortcode(name, pos, kw)
                if opened is not None:
                    out += opened[0]
                    if not sc.group(4).strip().endswith("/") and name not in ("figure", "img", "image"):
                        stack.append((name, opened[1]))
                    continue
            if mdx:
                one = re.match(r"^\s*(<([A-Z][\w.]*)(?:\s[^>]*)?>)(.*)(</\2>)\s*$", line)
                if one and self._component(one.group(1), stack, out):   # <Aside>text</Aside>
                    out.append(self._inline_components(one.group(3)))
                    self._component(one.group(4), stack, out)
                    continue
            if mdx and re.match(r"^\s*</?[A-Z]", line):
                j, tag = i, line
                # props can hold objects and arrow functions over many lines: the tag ends
                # at a line-final ">" once its braces balance
                while j < len(lines) and j - i < 200 and not (
                        re.search(r">\s*$", tag) and tag.count("{") <= tag.count("}")):
                    tag += "\n" + lines[j]
                    j += 1
                if self._component(tag, stack, out):
                    i = j
                    continue
            if mdx:
                line = self._inline_components(line)
            out.append(SHORTCODE.sub(lambda m: self._inline_shortcode(m, base, meta), line))
        for _, end in reversed(stack):
            out += end
        return "\n".join(out).replace(LITERAL_BRACES, "{{")


def render_rst(text: str) -> str | None:
    """reStructuredText (Sphinx and most Python projects) to HTML via docutils.

    Sphinx-only directives such as toctree or autodoc are unknown to plain
    docutils; their error reports are silenced so the surrounding prose still
    renders. Returns None when docutils can't be used, and the caller falls back
    to preformatted text.
    """
    try:
        import io
        from docutils.core import publish_parts
    except ImportError:
        return None
    overrides = {
        "report_level": 5, "halt_level": 5, "warning_stream": io.StringIO(),
        "traceback": False, "doctitle_xform": False, "syntax_highlight": "none",
        # a docs folder is no place to read other files or inject raw HTML from
        "file_insertion_enabled": False, "raw_enabled": False,
    }
    try:
        return publish_parts(text, writer_name="html5", settings_overrides=overrides)["body"]
    except Exception:   # docutils raises its own hierarchy on malformed input
        return None


def render_page(page: Page, html_map: dict[str, str], md_map: dict[str, str],
                links: "WikiLinks | None" = None, templates: "Templates | None" = None) -> None:
    text = page.src.read_text(encoding="utf-8", errors="replace")
    if page.kind == "md":
        meta, body = split_front_matter(text)
        mdx = page.src.suffix.lower() == ".mdx"
        if templates:
            body = templates.expand(body, page, meta)
        source = normalize_markdown(body, mdx=mdx, links=links, page=page)
        # generators print the front-matter title themselves when the body has no H1
        if meta.get("title") and not re.match(r"#\s", source.lstrip()):
            source = f"# {meta['title']}\n\n{source}"
        MD_RENDERER.reset()
        page.html_body = rewrite_md_links(MD_RENDERER.convert(source), page, html_map)
        plain = normalize_markdown(body, mdx=mdx, callouts=False, links=links, page=page)
        page.md_body = rewrite_links_for_md_book(plain, page, md_map)
    elif page.kind == "rst":
        body = render_rst(text)
        page.html_body = (rewrite_md_links(body, page, html_map) if body is not None
                          else f"<pre class='plaintext'>{html_mod.escape(text)}</pre>")
        page.md_body = f"```rst\n{text}\n```"
    elif page.kind == "html":
        meta, text = split_front_matter(text)
        if templates and templates.liquid:   # a Jekyll page written in HTML is a template too
            text = templates.expand(text, page, meta)
        body = extract_html_body(text)
        page.html_body = rewrite_md_links(body, page, html_map)
        # markdown renders inline HTML, so the body carries over as-is
        page.md_body = rewrite_links_for_md_book(body, page, md_map)
    elif page.kind == "text":
        page.html_body = f"<pre class='plaintext'>{html_mod.escape(text)}</pre>"
        page.md_body = f"```\n{text}\n```" if page.src.suffix.lower() != ".md" else text
    else:  # code
        fenced = f"```{page.lang}\n{text}\n```"
        MD_RENDERER.reset()
        page.html_body = MD_RENDERER.convert(fenced)
        page.md_body = fenced


