# ----------------------------------------------------------------------------
# File classification

DOC_EXTS = {".md", ".markdown", ".mdown", ".mkd", ".txt", ".rst", ".adoc", ".asciidoc"}
CODE_EXTS = {
    ".py": "python", ".js": "javascript", ".ts": "typescript", ".tsx": "tsx",
    ".jsx": "jsx", ".rs": "rust", ".go": "go", ".java": "java", ".rb": "ruby",
    ".sh": "bash", ".zsh": "bash", ".c": "c", ".h": "c", ".cpp": "cpp",
    ".hpp": "cpp", ".cs": "csharp", ".swift": "swift", ".kt": "kotlin",
    ".yaml": "yaml", ".yml": "yaml", ".json": "json", ".toml": "toml",
    ".ini": "ini", ".cfg": "ini", ".sql": "sql",
    ".css": "css", ".xml": "xml", ".proto": "protobuf", ".graphql": "graphql",
    ".dockerfile": "dockerfile", ".tf": "terraform", ".lua": "lua", ".r": "r",
}
SKIP_DIRS = {
    ".git", ".hg", ".svn", "node_modules", "__pycache__", ".venv", "venv",
    "env", ".tox", ".mypy_cache", ".pytest_cache", ".ruff_cache", "dist",
    "build", "target", ".next", ".nuxt", ".cache", "coverage", ".idea",
    ".vscode", "vendor", ".terraform", ".DS_Store", ".bookify",
}
MD_EXTS = {".md", ".markdown", ".mdown", ".mkd"}
HTML_EXTS = {".html", ".htm", ".xhtml"}
# files a doc can point at and expect to still be there in the output
ASSET_EXTS = {
    ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".avif", ".ico", ".bmp",
    ".pdf", ".mp4", ".webm", ".mov", ".m4v", ".mp3", ".wav", ".ogg",
    ".woff", ".woff2", ".ttf", ".otf", ".csv", ".tsv", ".zip",
}
MAX_ASSET_BYTES = 25 * 1024 * 1024

MD_RENDERER = md_lib.Markdown(
    extensions=["extra", "toc", "sane_lists", "codehilite", "admonition"],
    extension_configs={"codehilite": {"guess_lang": False, "css_class": "highlight"}},
)


@dataclass
class Page:
    src: Path            # absolute source path
    rel: Path            # path relative to the root folder
    title: str = ""
    kind: str = "md"     # md | text | code
    lang: str = ""       # pygments hint for code files
    html_body: str = ""
    md_body: str = ""
    # prev/next are cyclic and link_* are derived: comparing them would make
    # Page.__eq__ recurse through the whole book
    prev: "Page | None" = field(default=None, repr=False, compare=False)
    next: "Page | None" = field(default=None, repr=False, compare=False)
    _out_html: "Path | None" = field(default=None, repr=False, compare=False)
    _out_md: "Path | None" = field(default=None, repr=False, compare=False)

    @property
    def out_rel_html(self) -> Path:
        if self._out_html:
            return self._out_html
        return self.default_out_html

    @property
    def default_out_html(self) -> Path:
        if self.kind == "html":
            return self.rel  # keep the original path so existing .html links still work
        if self.kind == "code":
            return self.rel.with_suffix(self.rel.suffix + ".html")
        return self.rel.with_suffix(".html")

    @property
    def out_rel_md(self) -> Path:
        if self._out_md:
            return self._out_md
        return self.default_out_md

    @property
    def default_out_md(self) -> Path:
        if self.kind == "md":
            return self.rel.with_suffix(".md")
        return self.rel.with_suffix(self.rel.suffix + ".md")


def first_heading(text: str) -> str | None:
    for line in text.splitlines():
        m = re.match(r"^#{1,6}\s+(.*)", line)
        if m:
            return re.sub(r"[#*`_\[\]]", "", m.group(1)).strip()
    return None


def html_title(text: str) -> str | None:
    m = re.search(r"<title[^>]*>(.*?)</title>", text, re.I | re.S) or \
        re.search(r"<h1[^>]*>(.*?)</h1>", text, re.I | re.S)
    if m:
        t = html_mod.unescape(re.sub(r"<[^>]+>", "", m.group(1))).strip()
        return t or None
    return None


def humanize(name: str) -> str:
    stem = Path(name).stem
    return re.sub(r"[-_]+", " ", stem).strip().title() or name


def sort_key(p: Path) -> tuple:
    """README/index first, then case-insensitive alphabetical."""
    stem = p.stem.lower()
    return (0 if stem in ("readme", "index", "home") else 1, str(p).lower())


def collect_pages(root: Path, include_code: bool) -> list[Page]:
    pages: list[Page] = []
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        if any(part in SKIP_DIRS or part.startswith(".") for part in path.relative_to(root).parts[:-1]):
            continue
        name = path.name
        if name.startswith(".") and name.lower() != ".env.example":
            continue
        ext = path.suffix.lower()
        kind = lang = None
        if ext in DOC_EXTS:
            kind = "md" if ext in MD_EXTS else "text"
        elif ext in HTML_EXTS:
            kind = "html"
        elif name.lower() in ("dockerfile", "makefile", "justfile"):
            if include_code:
                kind, lang = "code", {"dockerfile": "dockerfile", "makefile": "makefile", "justfile": "makefile"}[name.lower()]
        elif ext in CODE_EXTS:
            if include_code:
                kind, lang = "code", CODE_EXTS[ext]
        if kind is None:
            continue
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        rel = path.relative_to(root)
        if kind == "md":
            title = first_heading(text) or humanize(name)
        elif kind == "html":
            title = html_title(text) or humanize(name)
        elif kind == "code":
            title = name  # keep exact filename for code pages
        else:
            title = humanize(name)
        pages.append(Page(src=path, rel=rel, title=title, kind=kind, lang=lang or ""))

    pages.sort(key=lambda p: (tuple(str(x).lower() for x in p.rel.parts[:-1]), sort_key(p.rel)))
    assign_out_paths(pages)
    for a, b in zip(pages, pages[1:]):
        a.next, b.prev = b, a
    return pages


def assign_out_paths(pages: list[Page]) -> None:
    """Give every page a unique output path in each book.

    Without this, sibling sources that differ only by extension (the common
    `README.md` + `README.rst` pair, say) both want `README.html` and one
    silently overwrites the other. HTML sources keep their exact path so
    hand-written .html links keep resolving; everyone else yields to them and
    then to whoever claimed the name first (page order is stable, so README.md
    keeps README.html and the .rst becomes README.rst.html).
    """
    for attr, default_attr, suffix in (("_out_html", "default_out_html", ".html"),
                                       ("_out_md", "default_out_md", ".md")):
        taken: set[Path] = {p.default_out_html for p in pages if p.kind == "html"} \
            if attr == "_out_html" else set()
        for p in pages:
            if attr == "_out_html" and p.kind == "html":
                continue
            cand = getattr(p, default_attr)
            if cand in taken:
                # disambiguate by keeping the source extension: foo.rst -> foo.rst.html
                cand = p.rel.with_suffix(p.rel.suffix + suffix)
            base, n = cand, 2
            while cand in taken:
                cand = base.with_name(f"{base.stem}-{n}{base.suffix}")
                n += 1
            taken.add(cand)
            setattr(p, attr, cand)


# ----------------------------------------------------------------------------
# Rendering

def build_link_maps(pages: list[Page]) -> tuple[dict[str, str], dict[str, str]]:
    """source path (posix, root-relative) -> output path, for each book."""
    html_map = {p.rel.as_posix(): p.out_rel_html.as_posix() for p in pages}
    md_map = {p.rel.as_posix(): p.out_rel_md.as_posix() for p in pages}
    return html_map, md_map


SKIP_HREF = ("http://", "https://", "mailto:", "tel:", "#", "/", "data:", "javascript:")


def _retarget(href: str, page_dir: str, out_dir: str, link_map: dict[str, str],
              fallback) -> str | None:
    """Map one relative href onto the target page's real output path.

    Returns the rewritten href, or None to leave the original untouched.
    Resolving through link_map (rather than swapping the suffix blindly) is what
    keeps links correct when a target had to be renamed to avoid a collision.
    """
    base, _, frag = href.partition("#")
    if not base:
        return None
    # Try the map for any relative href, whatever its extension: with
    # --include-code a link to scripts/foo.py has a rendered page too, and only
    # real pages are ever in the map. Extension-based guessing is the fallback.
    key = posixpath.normpath(posixpath.join(page_dir, base))
    out = link_map.get(key)
    if out is None:
        ext = Path(base).suffix.lower()
        if ext not in DOC_EXTS and ext not in HTML_EXTS:
            return None
        out = fallback(key)
        if out is None:
            return None
    rel = posixpath.relpath(out, out_dir or ".")
    return rel + ("#" + frag if frag else "")


def rewrite_md_links(html: str, page: Page, link_map: dict[str, str]) -> str:
    """Point relative links at the rendered HTML page for that source file."""
    page_dir = page.rel.parent.as_posix()
    page_dir = "" if page_dir == "." else page_dir
    out_dir = posixpath.dirname(page.out_rel_html.as_posix())

    def fallback(key: str) -> str | None:
        # target isn't a collected page (percent-encoded name, or outside the
        # tree): keep the old behaviour so nothing that used to work breaks
        ext = Path(key).suffix.lower()
        if ext in DOC_EXTS:
            return posixpath.splitext(key)[0] + ".html"
        return None

    def repl(m: re.Match) -> str:
        href = m.group(2)
        if href.startswith(SKIP_HREF):
            return m.group(0)
        new = _retarget(href, page_dir, out_dir, link_map, fallback)
        return m.group(0) if new is None else f"{m.group(1)}{new}{m.group(3)}"

    return re.sub(r'(href=")([^"]+)(")', repl, html)


def collect_assets(pages: list[Page], root: Path) -> dict[str, Path]:
    """Local files the rendered pages point at (images, diagrams, PDFs, fonts).

    Returns {root-relative posix path: source file}. Without copying these, a
    doc that embeds a diagram renders a broken image, since only doc/code files
    are ever collected as pages.
    """
    found: dict[str, Path] = {}
    ref = re.compile(r'(?:src|href)="([^"]+)"')
    root_resolved = root.resolve()
    for page in pages:
        page_dir = page.rel.parent.as_posix()
        page_dir = "" if page_dir == "." else page_dir
        for m in ref.finditer(page.html_body):
            href = m.group(1)
            if href.startswith(SKIP_HREF):
                continue
            base = href.partition("#")[0].partition("?")[0]
            if not base or Path(base).suffix.lower() not in ASSET_EXTS:
                continue
            key = posixpath.normpath(posixpath.join(page_dir, unquote(base)))
            if key.startswith("..") or key in found:
                continue
            src = root / key
            try:
                if not src.is_file() or src.stat().st_size > MAX_ASSET_BYTES:
                    continue
                # don't follow a link out of the tree we were asked to render
                if root_resolved not in src.resolve().parents:
                    continue
            except OSError:
                continue
            found[key] = src
    return found


def copy_assets(assets: dict[str, Path], *dests: Path) -> int:
    n = 0
    for key, src in assets.items():
        for dest_root in dests:
            dest = dest_root / key
            dest.parent.mkdir(parents=True, exist_ok=True)
            try:
                shutil.copyfile(src, dest)
            except OSError:
                continue
        n += 1
    return n


def extract_html_body(text: str) -> str:
    """Pull the displayable content out of a full HTML document."""
    m = re.search(r"<body[^>]*>(.*)</body>", text, re.I | re.S)
    body = m.group(1) if m else re.sub(
        r"<!doctype[^>]*>|</?html[^>]*>|<head[^>]*>.*?</head>", "", text,
        flags=re.I | re.S)
    # scripts and document-level styles would fight the book's own layout
    body = re.sub(r"<script[^>]*>.*?</script>", "", body, flags=re.I | re.S)
    body = re.sub(r"<style[^>]*>.*?</style>", "", body, flags=re.I | re.S)
    return body.strip()


def rewrite_links_for_md_book(text: str, page: Page, md_map: dict[str, str]) -> str:
    """In the Markdown book, pages can be renamed (<name>.<ext>.md, or -2 to
    break a collision) — point relative links at the real output name."""
    page_dir = page.rel.parent.as_posix()
    page_dir = "" if page_dir == "." else page_dir
    out_dir = posixpath.dirname(page.out_rel_md.as_posix())

    def fallback(key: str) -> str | None:
        ext = Path(key).suffix.lower()
        return key if ext in MD_EXTS else key + ".md"

    def fix(href: str) -> str:
        if href.startswith(SKIP_HREF):
            return href
        new = _retarget(href, page_dir, out_dir, md_map, fallback)
        return href if new is None else new

    text = re.sub(r"(\]\()([^)\s]+)(\))", lambda m: m.group(1) + fix(m.group(2)) + m.group(3), text)
    return re.sub(r'(href=")([^"]+)(")', lambda m: m.group(1) + fix(m.group(2)) + m.group(3), text)


def render_page(page: Page, html_map: dict[str, str], md_map: dict[str, str]) -> None:
    text = page.src.read_text(encoding="utf-8", errors="replace")
    if page.kind == "md":
        MD_RENDERER.reset()
        page.html_body = rewrite_md_links(MD_RENDERER.convert(text), page, html_map)
        page.md_body = rewrite_links_for_md_book(text, page, md_map)
    elif page.kind == "html":
        body = extract_html_body(text)
        page.html_body = rewrite_md_links(body, page, html_map)
        # markdown renders inline HTML, so the body carries over as-is
        page.md_body = rewrite_links_for_md_book(body, page, md_map)
    elif page.kind == "text":
        page.html_body = f"<pre class='plaintext'>{html_mod.escape(text)}</pre>"
        page.md_body = f"```\n{text}\n```" if page.src.suffix.lower() != ".md" else text
    else:  # code
        fenced = f"```{page.lang}\n{text}\n```"
        MD_RENDERER.reset()
        page.html_body = MD_RENDERER.convert(fenced)
        page.md_body = fenced


